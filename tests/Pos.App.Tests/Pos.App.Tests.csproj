<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Pos.App.Tests</RootNamespace>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pos.App\Pos.App.csproj" />
    <!--
      The real font engine. It is referenced here rather than only through the till because the
      Tamil rendering tests need a Windows target, and this is the test project that has one.
    -->
    <ProjectReference Include="..\..\src\Pos.Core.Hardware.Windows\Pos.Core.Hardware.Windows.csproj" />
    <!--
      The `pos` tool. Referenced so its command line can be tested directly rather than by running
      the executable and reading its output — the options it accepts decide whether a typo closes
      a day, and that deserves assertions rather than a shell script.
    -->
    <ProjectReference Include="..\..\src\Pos.Diagnostics\Pos.Diagnostics.csproj" />
    <ProjectReference Include="..\Pos.TestSupport\Pos.TestSupport.csproj" />
  </ItemGroup>

</Project>
