<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

<!--
  Noon: the brightest look, for a counter near the door at midday, when sunlight on the screen
  washes out anything faint. White cards, the blackest ink, darker greys for the quiet text and
  firmer edges on every box and button - the most contrast of the four, at the cost of being the
  least restful. The same names as Night.xaml; see there.
-->

    <sys:Boolean x:Key="IsDarkTheme">False</sys:Boolean>

    <SolidColorBrush x:Key="Surface" Color="#FFEEF1F5" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SurfaceHeader" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="Ink" Color="#FF020617" />
    <SolidColorBrush x:Key="InkMuted" Color="#FF334155" />
    <SolidColorBrush x:Key="InkDim" Color="#FF475569" />

    <SolidColorBrush x:Key="Accent" Color="#FF075985" />
    <SolidColorBrush x:Key="Positive" Color="#FF064E3B" />
    <SolidColorBrush x:Key="Negative" Color="#FFC0193F" />
    <SolidColorBrush x:Key="Line" Color="#FFCBD5E1" />

    <SolidColorBrush x:Key="RowActive" Color="#FFD6ECFB" />
    <SolidColorBrush x:Key="RowAlt" Color="#FFF4F6F9" />
    <SolidColorBrush x:Key="RowHover" Color="#0D020617" />
    <SolidColorBrush x:Key="RowStripe" Color="#08020617" />

    <SolidColorBrush x:Key="FieldBorder" Color="#FF475569" />
    <SolidColorBrush x:Key="FieldBorderHover" Color="#FF334155" />
    <SolidColorBrush x:Key="FieldFill" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="AccentGlow" Color="#4D075985" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Danger" Color="#FFB0161A" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FFFDE8E8" />
    <SolidColorBrush x:Key="Warning" Color="#FF7A3410" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FFFDF0C2" />
    <SolidColorBrush x:Key="Done" Color="#FF064E3B" />
    <SolidColorBrush x:Key="DoneSoft" Color="#FFD6F7E3" />
    <SolidColorBrush x:Key="InfoSoft" Color="#FFDDEFFC" />
    <SolidColorBrush x:Key="Saving" Color="#FF853A0B" />

    <SolidColorBrush x:Key="Scrim" Color="#99020617" />

    <SolidColorBrush x:Key="ButtonFace" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ButtonFaceHover" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="ButtonFacePressed" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="ButtonEdge" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="ButtonEdgeHover" Color="#FF64748B" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF064A6E" />

    <SolidColorBrush x:Key="CardEdge" Color="#FFCBD5E1" />
    <SolidColorBrush x:Key="IconChip" Color="#FFDDEFFC" />

    <SolidColorBrush x:Key="ChipFill" Color="#10020617" />
    <SolidColorBrush x:Key="ChipFillStrong" Color="#1A020617" />
    <SolidColorBrush x:Key="KeyCapFill" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="KeyCapEdge" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="Well" Color="#FFF1F5F9" />

    <SolidColorBrush x:Key="ScrollThumb" Color="#FF64748B" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#FF475569" />

    <SolidColorBrush x:Key="ChartColour0" Color="#FF0369A1" />
    <SolidColorBrush x:Key="ChartColour1" Color="#FF047857" />
    <SolidColorBrush x:Key="ChartColour2" Color="#FFB45309" />
    <SolidColorBrush x:Key="ChartColour3" Color="#FF6D28D9" />
    <SolidColorBrush x:Key="ChartColour4" Color="#FFBE185D" />
    <SolidColorBrush x:Key="ChartColour5" Color="#FF0F766E" />
    <SolidColorBrush x:Key="ChartColour6" Color="#FF475569" />
    <SolidColorBrush x:Key="ChartGrid" Color="#FFE2E8F0" />
    <SolidColorBrush x:Key="ChartAxisLine" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="ChartTooltip" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ChartTooltipEdge" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="ChartHeat0" Color="#FFF1F5F9" />
    <SolidColorBrush x:Key="ChartHeat1" Color="#FF7DD3FC" />
    <SolidColorBrush x:Key="ChartHeat2" Color="#FF0284C7" />
    <SolidColorBrush x:Key="ChartHeat3" Color="#FF075985" />

    <LinearGradientBrush x:Key="AppBackdrop" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFF1F4F8" Offset="0" />
      <GradientStop Color="#FFE9EDF2" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFFFFFFF" Offset="0" />
      <GradientStop Color="#FFFBFCFD" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="TotalFill" Center="1,0" GradientOrigin="1,0" RadiusX="1.1" RadiusY="1.4">
      <GradientStop Color="#FFDDF4E8" Offset="0" />
      <GradientStop Color="#FFF6FAF8" Offset="0.65" />
      <GradientStop Color="#FFFFFFFF" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="PayFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF166534" Offset="0" />
      <GradientStop Color="#FF14532D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RankFill" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF075985" Offset="0" />
      <GradientStop Color="#FF0369A1" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
