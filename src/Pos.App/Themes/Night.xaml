<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

<!--
  Night: the till's own look, dark, for a shop lit by its tube lights after sunset - and the look a
  lane has unless the owner chooses another (Settings, Ctrl+5).

  One of four palettes - Morning, Noon, Evening and Night - that define the same colours under the
  same names. Theme.xaml styles every window from these names, and the look is changed by swapping
  which of the four is loaded (Looks.Apply), so every one of them has to define every name. A name
  missing from one look would draw nothing in it; PaletteTests fails the build on that, and
  ThemeContrastTests measures each look against the same bars.
-->

    <!-- Whether this look is dark, so the window's title bar is drawn to match. -->
    <sys:Boolean x:Key="IsDarkTheme">True</sys:Boolean>

    <!-- High contrast on a bright shop floor, and legible at arm's length. -->
    <SolidColorBrush x:Key="Surface" Color="#FF0A0D13" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#FF111722" />
    <SolidColorBrush x:Key="SurfaceHeader" Color="#FF141C2B" />
    <SolidColorBrush x:Key="Ink" Color="#FFF8FAFC" />
    <SolidColorBrush x:Key="InkMuted" Color="#FF94A3B8" />

    <!--
      The quietest ink on the screen, and it still has to be legible.

      It was #FF64748B, which reads well enough on a developer's monitor and measures 3.15:1 against
      a selected row - below the 4.5:1 that normal-size text needs to stay readable on a cheap panel
      under shop lighting. That mattered because this is not only the line number: it is the MRP
      column, and a price nobody can quite read is worse than one that was never shown.

      #FF8292A8 is the smallest step that clears 4.5:1 on every background this is drawn against. It
      sits closer to InkMuted than it used to, which is the cost of the change; the two are still
      distinguishable, and legibility is worth more here than the width of that gap.
      ThemeContrastTests holds the figures and fails if either moves back.
    -->
    <SolidColorBrush x:Key="InkDim" Color="#FF8292A8" />

    <SolidColorBrush x:Key="Accent" Color="#FF38BDF8" />
    <SolidColorBrush x:Key="Positive" Color="#FF10B981" />

    <!--
      Money off. Was #FFF43F5E, which measured 4.09:1 on a selected row - so the one figure on the
      line saying a customer is being charged less than the shelf price was the hardest to read on
      the row the cashier had actually selected. Lightened to clear 4.5:1 everywhere; still
      unmistakably red, and still never the same colour as money taken.
    -->
    <SolidColorBrush x:Key="Negative" Color="#FFF85D76" />
    <SolidColorBrush x:Key="Line" Color="#FF232B38" />

    <!-- The row a scan just landed on, and the tint that separates one row from the next. -->
    <SolidColorBrush x:Key="RowActive" Color="#FF16283A" />
    <SolidColorBrush x:Key="RowAlt" Color="#FF141A25" />

    <!-- A row under the mouse: a breath lighter, well short of the selected row's tint. -->
    <SolidColorBrush x:Key="RowHover" Color="#0FFFFFFF" />

    <!-- Every other row of a grid that sits on a card: RowAlt's step, laid over the card's gradient
         rather than painted as a block of its own colour across it. -->
    <SolidColorBrush x:Key="RowStripe" Color="#08FFFFFF" />

    <!--
      The edge of a box you type in.

      Boxes used to be edged in the divider colour, 1.26:1 against a card, so an empty one was a
      rectangle you had to look for. A control's outline has to reach 3:1 to be seen at all on a
      counter; this is the smallest step that does on the page and on a card, and still sits well
      below the ink so a box never reads as text. ThemeContrastTests holds it there.
    -->
    <SolidColorBrush x:Key="FieldBorder" Color="#FF5B6B82" />
    <SolidColorBrush x:Key="FieldBorderHover" Color="#FF7A8BA3" />
    <SolidColorBrush x:Key="FieldFill" Color="#FF0B0F15" />

    <!-- The glow round a box or button that has the keyboard. -->
    <SolidColorBrush x:Key="AccentGlow" Color="#5938BDF8" />

    <!-- Dark text for a bright face: a button in the accent, the green Pay key. -->
    <SolidColorBrush x:Key="OnAccent" Color="#FF04121C" />

    <!--
      What a message is, by colour as well as by word.

      The till used to say everything in one blue - "the receipt did not print" in the same colour as
      "bill held as H001". Each kind now has an ink that clears 4.5:1 on the dark panels, and a
      tinted ground to sit on. Red is kept for things that went wrong, amber for things to check.
    -->
    <SolidColorBrush x:Key="Danger" Color="#FFF87171" />
    <SolidColorBrush x:Key="DangerSoft" Color="#FF2A1519" />
    <SolidColorBrush x:Key="Warning" Color="#FFF5B544" />
    <SolidColorBrush x:Key="WarningSoft" Color="#FF2B2213" />
    <SolidColorBrush x:Key="Done" Color="#FF34D399" />
    <SolidColorBrush x:Key="DoneSoft" Color="#FF0F2A21" />
    <SolidColorBrush x:Key="InfoSoft" Color="#FF10243A" />

    <!--
      Money off, from the customer's side: amber, the same on the line, in the bill card and beside
      the total. It used to be red on the line and green as "Saved" beside the total - one saving in
      two colours, one of them the colour of a mistake.
    -->
    <SolidColorBrush x:Key="Saving" Color="#FFF5B544" />

    <!-- The pane over the billing screen, dimming what is behind it. -->
    <SolidColorBrush x:Key="Scrim" Color="#E6060910" />

    <!-- Buttons: raised a little off the card, lighter under the mouse. -->
    <SolidColorBrush x:Key="ButtonFace" Color="#FF1B2636" />
    <SolidColorBrush x:Key="ButtonFaceHover" Color="#FF243247" />
    <SolidColorBrush x:Key="ButtonFacePressed" Color="#FF151E2B" />
    <SolidColorBrush x:Key="ButtonEdge" Color="#FF2A384C" />
    <SolidColorBrush x:Key="ButtonEdgeHover" Color="#FF3E5068" />
    <SolidColorBrush x:Key="AccentHover" Color="#FF7DD3FC" />

    <!-- Cards, and the rim that lifts them off the page. -->
    <SolidColorBrush x:Key="CardEdge" Color="#FF1F2937" />
    <SolidColorBrush x:Key="IconChip" Color="#FF16283A" />

    <!-- Small chips laid over a card - a lane's name, a count of lines, a key in the owner's list -
         and the face of a key drawn on screen. -->
    <SolidColorBrush x:Key="ChipFill" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="ChipFillStrong" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="KeyCapFill" Color="#FF1E293B" />
    <SolidColorBrush x:Key="KeyCapEdge" Color="#FF2E3B4F" />

    <!-- A sunken panel for what a job printed - a check of the database, a bill as text. -->
    <SolidColorBrush x:Key="Well" Color="#FF0B0F13" />

    <!-- A scrollbar's thumb, which is a control and has to be seen: 3:1 on the panels it runs down. -->
    <SolidColorBrush x:Key="ScrollThumb" Color="#FF55657C" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#FF7A8BA3" />

    <!--
      The charts' colours. The first three carry the meanings the rest of the screen already gives
      them - the accent, money taken, money off - and the rest are told apart by lightness as well as
      hue, so a legend still works for somebody who confuses red and green.
    -->
    <SolidColorBrush x:Key="ChartColour0" Color="#FF38BDF8" />
    <SolidColorBrush x:Key="ChartColour1" Color="#FF10B981" />
    <SolidColorBrush x:Key="ChartColour2" Color="#FFF5B544" />
    <SolidColorBrush x:Key="ChartColour3" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="ChartColour4" Color="#FFF472B6" />
    <SolidColorBrush x:Key="ChartColour5" Color="#FF2DD4BF" />
    <SolidColorBrush x:Key="ChartColour6" Color="#FF94A3B8" />
    <SolidColorBrush x:Key="ChartGrid" Color="#FF1C2533" />
    <SolidColorBrush x:Key="ChartAxisLine" Color="#FF333F52" />
    <SolidColorBrush x:Key="ChartTooltip" Color="#FF0C121C" />
    <SolidColorBrush x:Key="ChartTooltipEdge" Color="#FF2E3B4F" />
    <SolidColorBrush x:Key="ChartHeat0" Color="#FF151E2C" />
    <SolidColorBrush x:Key="ChartHeat1" Color="#FF0E3B57" />
    <SolidColorBrush x:Key="ChartHeat2" Color="#FF177FB5" />
    <SolidColorBrush x:Key="ChartHeat3" Color="#FF7DD3FC" />

    <!--
      Depth. The page darkens a little towards the foot, and a card is lighter at its top edge than
      its bottom, as if lit from above. Both are slight: enough to separate the layers, not enough to
      be noticed as an effect.
    -->
    <LinearGradientBrush x:Key="AppBackdrop" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF0C1119" Offset="0" />
      <GradientStop Color="#FF090C12" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF131A26" Offset="0" />
      <GradientStop Color="#FF10161F" Offset="1" />
    </LinearGradientBrush>

    <!-- The grand total's card: a green glow from the corner the figure sits in. -->
    <RadialGradientBrush x:Key="TotalFill" Center="1,0" GradientOrigin="1,0" RadiusX="1.1" RadiusY="1.4">
      <GradientStop Color="#FF0D2A24" Offset="0" />
      <GradientStop Color="#FF09131A" Offset="0.65" />
      <GradientStop Color="#FF080E16" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="PayFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF34D399" Offset="0" />
      <GradientStop Color="#FF10B981" Offset="1" />
    </LinearGradientBrush>

    <!-- The bars in the owner's ranked lists, as wide as each row's share of the biggest. -->
    <LinearGradientBrush x:Key="RankFill" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF0EA5E9" Offset="0" />
      <GradientStop Color="#FF38BDF8" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
