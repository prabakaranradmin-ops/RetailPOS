<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Pos.App</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pos.Core.Domain\Pos.Core.Domain.csproj" />
    <ProjectReference Include="..\Pos.Core.Configuration\Pos.Core.Configuration.csproj" />
    <ProjectReference Include="..\Pos.Core.Data\Pos.Core.Data.csproj" />
    <ProjectReference Include="..\Pos.Core.Tax\Pos.Core.Tax.csproj" />
    <ProjectReference Include="..\Pos.Core.Logging\Pos.Core.Logging.csproj" />

    <!--
      The figures behind the owner's screen. The same queries the HTML report is built from, so the
      two cannot drift into disagreeing about what the shop took.
    -->
    <ProjectReference Include="..\Pos.Core.Analytics\Pos.Core.Analytics.csproj" />
    <ProjectReference Include="..\Pos.Core.Hardware.Windows\Pos.Core.Hardware.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Which folder the till bills against is internal because nothing outside the app decides it,
      but it is worth testing directly: choosing the wrong one does not throw or look broken, it
      just quietly opens somebody else's lane.
    -->
    <InternalsVisibleTo Include="Pos.App.Tests" />
  </ItemGroup>

</Project>
