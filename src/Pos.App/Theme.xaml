<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:app="clr-namespace:Pos.App"
                    xmlns:charts="clr-namespace:Pos.App.Charts">

<!--
  The till's look, kept apart from the application that starts it.

  Split out so it can be loaded on its own. App.xaml carries x:Class, which makes it an
  application definition rather than a plain dictionary, and WPF refuses to load one of those into
  anything but the App it belongs to - so while the palette lived there, no test could read the
  brushes the screen actually uses without starting the whole lane. The palettes are now in
  Themes\, one per look; ThemeContrastTests measures every one of them, and a colour that stops
  being legible has to fail a test rather than wait to be noticed on a counter.

  Everything a window is made of is styled here, once, for every window. The owner's screen used to
  carry its own buttons and boxes, and the PIN prompt in front of it - a window of its own - got the
  system's instead: white labels on pale grey buttons, 1.3:1, on the one screen every owner sees.
  Styles that live here cannot be left behind by a new window.
-->


    <!--
      The colours are not here. Each look - Morning, Noon, Evening and Night - is a palette of its
      own in Themes\, defining the same names, and one of them is loaded alongside this file
      (Looks.Apply). Everything below takes its colours by those names as dynamic resources, so
      changing the look repaints every open window at once.
    -->

    <!--
      Figures use a monospaced face so a column of them lines up on the decimal point and a digit
      never shifts as the value changes. Segoe UI and Cascadia Mono are both on every Windows the
      till runs on, so nothing has to be shipped or installed for this to render.
    -->
    <FontFamily x:Key="FigureFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- The icons: a font every Windows 10 and 11 already has. See Glyphs.cs. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- An icon from the icon font, sized and coloured like the text beside it. -->
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!--
      The keyboard's outline, the same everywhere: two pixels of the accent just outside the control.

      The system's own is a dotted black rectangle, 1.17:1 on these cards - which on the owner's
      screen meant a Tab press landed somewhere nobody could see.
    -->
    <Style x:Key="AccentFocusVisual">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" RadiusX="7" RadiusY="7" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                       SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The stock header template paints itself light, which is illegible on this background. -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />

      <!--
        6px, not 8. The line grid carries thirteen columns and several of them are sized by their
        header rather than their values ("CGST %" is wider than "2.5"), so horizontal padding here
        is multiplied thirteen times over. At 8px the row no longer fitted a 1920px till and the
        Total column — the one figure on a line that nobody should have to scroll to see — fell off
        the right-hand edge.
      -->
      <Setter Property="Padding" Value="6,6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!--
      Owner's tables: see-through on their cards, lines between the rows only, no row headers. The
      till's own bill grid sets its colours itself and keeps them.
    -->
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Line}" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <!--
      A row: a bar of the accent down its left edge while it is the selected one.

      The selected line of the bill was marked by a tint alone, 1.2:1 against the lines round it -
      and it is the line Delete, F3 and F4 act on. The pick lists already had this bar; the grids now
      have it too, so "which one is chosen" looks the same wherever it is asked. Every row carries the
      three pixels, transparent when not selected, so selecting one does not shift its figures.
    -->
    <Style TargetType="DataGridRow">
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridRow">
            <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                    BorderThickness="3,0,0,0" SnapsToDevicePixels="True">
              <SelectiveScrollingGrid>
                <SelectiveScrollingGrid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </SelectiveScrollingGrid.ColumnDefinitions>
                <SelectiveScrollingGrid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </SelectiveScrollingGrid.RowDefinitions>
                <Border x:Name="Hover" Grid.Column="1" Grid.RowSpan="2" Background="Transparent" />
                <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}"
                                          SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                   Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
              </SelectiveScrollingGrid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource RowHover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,0" />

      <!-- The row's accent bar says which row has the keyboard; a dotted box round one cell as well said it twice, faintly. -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <!--
            A tint, not a solid fill.

            The selected row used to be painted solid accent with dark text. That worked for the
            columns set in plain ink and ruined the ones deliberately set quiet — the HSN and the
            barcode kept their muted grey and went nearly invisible against bright blue. A tint
            leaves every column the colour it was chosen to be and still says which row is current.
          -->
          <Setter Property="Background" Value="{DynamicResource RowActive}" />

          <!--
            And the ink is held as well as the fill, which the tint alone did not do.

            Selecting a row hands the cell the theme's highlight-text colour, which is meant for a
            solid highlight and is close to unreadable over a tint on a dark grid. It showed only on
            the columns that take their colour by inheritance - the item name, the quantity and the
            rate - because every other column sets its own foreground in an ElementStyle and so was
            never affected. The result was that selecting a line dimmed precisely the three things a
            cashier reads off it while a customer waits.

            Setting it here restores those three. The columns with an explicit foreground still win,
            because that is set on the TextBlock itself, so the quiet ones stay quiet.
          -->
          <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- A figure in a table, set right so a column of them lines up. -->
    <Style x:Key="NumberColumn" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontFamily" Value="{StaticResource FigureFont}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!--
      Why a button is greyed out, in a line beside it: what is still missing. Gone once the button
      can be pressed. A greyed "Add it" with nothing said about it read as broken.
    -->
    <Style x:Key="WhyNot" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Text in a table that can outgrow its column: ends in "…" instead of stopping mid-word. -->
    <Style x:Key="TrimmedColumn" TargetType="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!--
      The side panel's sections. The bill grid has a heading row that says what each column is; the
      panel beside it was a bare list of numbers, so the same figures were harder to find there than
      in the grid. These give it the same structure.
    -->
    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0,1,10,1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Right-aligned and tabular, so a column of figures lines up on the decimal point. -->
    <Style x:Key="FieldValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,1,0,1" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      A list row: tinted and barred in the accent when it is the one chosen, lit a little under the
      mouse.

      The system's own template drew the chosen row in its own grey - the held bills and the
      tenders looked as if they belonged to another program - and a colour set on the row could not
      reach through it. This one is drawn here, so a chosen row looks the same in every list.
    -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />

      <!--
        Without this a row is only as wide as its content, so a Grid column set to * inside an item
        template collapses and the columns run into each other — a search result reads
        "Sugar LooseSUG001" instead of laying the name, code and price out across the row.
      -->
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowActive}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!--
      A pick-list row that stays readable when it is the one picked.

      The general ListBoxItem style above fills a selected row with the accent colour and sets its
      foreground dark - but the TextBlock style at the top of this file sets ink explicitly, and
      text in an item template takes that over the row's foreground. White on the light accent is
      about 2:1, which is the same class of fault as the bill grid's selected line. This row is
      tinted instead, like the grid, and marked with an accent bar so the choice is still obvious
      from across a counter. Ink on the tint is 14.35:1; ThemeContrastTests holds that figure.

      Not focusable: these lists are walked with the arrows from the box above them, which keeps
      the keyboard in the box.
    -->
    <Style x:Key="TintedListItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                    BorderThickness="3,0,0,0" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowActive}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      One choice in a row of choices laid across - the tenders. The accent bar runs along the foot
      rather than down the side, under the one chosen, like a tab.
    -->
    <Style x:Key="SegmentItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="Padding" Value="8,10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3"
                    Padding="{TemplateBinding Padding}" Margin="2,0" CornerRadius="6,6,0,0">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock" />
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowHover}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowActive}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ==== Buttons ============================================================================== -->

    <!--
      A button: a raised face with the label in its own colour, a ring of the accent while it has the
      keyboard.

      The label is told to take the button's colour rather than the TextBlock style's ink. That style
      reaches every text on the screen, the labels inside buttons included, which is how the PIN
      prompt's buttons ended up white on pale grey - and it would make the dark label on a bright
      button white on the bright face too.
    -->
    <Style TargetType="Button">
      <Style.Resources>
        <!-- Text inside a button takes the button's colour and size: see above. -->
        <Style TargetType="TextBlock" />
      </Style.Resources>
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource ButtonFace}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonEdge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Ring" Margin="-3" CornerRadius="10" BorderBrush="{DynamicResource Accent}"
                      BorderThickness="2" Opacity="0" />
              <Border x:Name="Face" CornerRadius="8" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock" />
                  </ContentPresenter.Resources>
                </ContentPresenter>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonFaceHover}" />
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ButtonEdgeHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonFacePressed}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.45" />
                <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The one thing a pane or a dialog is for: the accent face, dark label. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource AccentHover}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!--
      A button that cannot be undone: forgetting a customer, removing the PIN. Red outline and red
      label on the ordinary face, so it is never mistaken for the Save beside it.
    -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>

    <!-- Quiet: no face until the mouse is on it. For the small buttons on a chart's card. -->
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <!-- ==== Boxes to type in ======================================================================== -->

    <!--
      A box: its edge at 3:1 so an empty one can be found, the accent and a soft glow round it while
      it has the keyboard. The glow sits outside the box, drawn by its own border, so the text inside
      is never blurred by it.
    -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource FieldFill}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="Glow" Margin="-3" CornerRadius="9" BorderBrush="{DynamicResource AccentGlow}"
                      BorderThickness="3" Opacity="0" />
              <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      SnapsToDevicePixels="True">
                <!-- Hidden unless a box asks, as the order box does for a long pasted message. -->
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                              HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FieldBorderHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Glow" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource FieldFill}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Grid>
              <Border x:Name="Glow" Margin="-3" CornerRadius="9" BorderBrush="{DynamicResource AccentGlow}"
                      BorderThickness="3" Opacity="0" />
              <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                      SnapsToDevicePixels="True">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FieldBorderHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Glow" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ==== Ticks and choices ===================================================================== -->

    <Style TargetType="CheckBox">
      <Style.Resources>
        <Style TargetType="TextBlock" />
      </Style.Resources>
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="19" Height="19" VerticalAlignment="Center">
                <Border x:Name="Ring" Margin="-3" CornerRadius="7" BorderBrush="{DynamicResource Accent}"
                        BorderThickness="2" Opacity="0" />
                <!-- The tick inside its box, so what it is drawn on is what it sits in. -->
                <Border x:Name="Box" CornerRadius="5" Background="{DynamicResource FieldFill}"
                        BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1.5">
                  <TextBlock x:Name="Tick" Text="{x:Static app:Glyphs.Check}" FontFamily="{StaticResource IconFont}"
                             FontSize="12" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center"
                             VerticalAlignment="Center" Visibility="Collapsed" />
                </Border>
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock" />
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource FieldBorderHover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      One of a set. The ring sits at the top of the choice rather than in its middle, so a choice
      with a paragraph under its name - the tax mode, the bill layout - still reads name first.
    -->
    <Style TargetType="RadioButton">
      <Style.Resources>
        <Style TargetType="TextBlock" />
      </Style.Resources>
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid Width="19" Height="19" VerticalAlignment="Top" Margin="0,1,0,0">
                <Ellipse x:Name="Halo" Margin="-3" Stroke="{DynamicResource Accent}" StrokeThickness="2" Opacity="0" />
                <Ellipse x:Name="Ring" Fill="{DynamicResource FieldFill}" Stroke="{DynamicResource FieldBorder}" StrokeThickness="1.5" />
                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{DynamicResource Accent}" Visibility="Collapsed" />
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock" />
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource FieldBorderHover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Halo" Property="Opacity" Value="1" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A choice drawn as one segment of a strip: 7 days, 30 days, 90 days. -->
    <Style x:Key="SegmentChoice" TargetType="RadioButton">
      <Style.Resources>
        <Style TargetType="TextBlock" />
      </Style.Resources>
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Padding" Value="12,5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="Ring" Margin="-3" CornerRadius="9" BorderBrush="{DynamicResource Accent}"
                      BorderThickness="2" Opacity="0" />
              <Border x:Name="Face" CornerRadius="6" Background="Transparent" BorderBrush="Transparent"
                      BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True">
                  <ContentPresenter.Resources>
                    <Style TargetType="TextBlock" />
                  </ContentPresenter.Resources>
                </ContentPresenter>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonFaceHover}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource RowActive}" />
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Ring" Property="Opacity" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ==== Scrollbars ================================================================================ -->

    <!--
      Thin and dark, with a thumb that can be seen: the system's were a pale grey bar, the only light
      thing on a dark screen, with a thumb 1.39:1 on its track.
    -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource ScrollThumb}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
      <Setter Property="Width" Value="10" />
      <Setter Property="MinWidth" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,3">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumbStyle}" MinHeight="24" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Height" Value="10" />
          <Setter Property="MinHeight" Value="10" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                  <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="3,2">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}" />
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumbStyle}" MinWidth="24" />
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}" />
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ==== Tooltips ==================================================================================== -->

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Background" Value="{DynamicResource ChartTooltip}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ChartTooltipEdge}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="10,7" MaxWidth="420">
              <ContentPresenter>
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                    <Setter Property="FontSize" Value="12.5" />
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Separator">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{DynamicResource Line}" SnapsToDevicePixels="True" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ==== Cards ========================================================================================= -->

    <!-- A card: lit from above, rimmed, rounded. What every panel on the owner's screen sits on. -->
    <Style x:Key="CardPanel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardEdge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- The small square an icon sits in, at the head of a card. -->
    <Style x:Key="IconBadge" TargetType="Border">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource IconChip}" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CardSubtitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <Style x:Key="CardCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <!--
      A chart on its card.

      The buttons are quiet until wanted - the picture and the table are there for when somebody
      asks, not something to read past on the way to the chart. None of them carries an access key:
      a page of these cards would give every one the same letter, and the owner's screen is tested
      for exactly that clash. They are reached with Tab like any button, and the chart after them.
    -->
    <Style TargetType="charts:ChartCard">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="charts:ChartCard">
            <Border Style="{StaticResource CardPanel}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <Border Style="{StaticResource IconBadge}" Margin="0,0,12,0">
                    <TextBlock Text="{TemplateBinding Glyph}" Style="{StaticResource Glyph}" FontSize="15"
                               HorizontalAlignment="Center" />
                  </Border>

                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="SubtitleText" Text="{TemplateBinding Subtitle}" Style="{StaticResource CardSubtitle}" />
                  </StackPanel>

                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                    <TextBlock x:Name="NoticeText" Text="{TemplateBinding Notice}" Foreground="{DynamicResource Done}"
                               FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="PART_Reset" Style="{StaticResource GhostButton}" Visibility="Collapsed"
                            ToolTip="Show every figure again (0, or double-click the chart)">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static app:Glyphs.ZoomOut}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Show all" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="PART_Table" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                            ToolTip="Read the figures as a table">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static app:Glyphs.Table}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="TableLabel" Text="Table" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="PART_Save" Style="{StaticResource GhostButton}" Margin="4,0,0,0"
                            ToolTip="Save the chart as a picture">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{x:Static app:Glyphs.Download}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Picture" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>

                <ContentPresenter x:Name="ChartHost" Grid.Row="1" />

                <DataGrid x:Name="PART_Grid" Grid.Row="1" Visibility="Collapsed" IsReadOnly="True"
                          AutoGenerateColumns="True" CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single" MaxHeight="340" FontSize="13" />

                <TextBlock x:Name="CaptionText" Grid.Row="2" Text="{TemplateBinding Caption}" Style="{StaticResource CardCaption}" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsShowingTable" Value="True">
                <Setter TargetName="ChartHost" Property="Visibility" Value="Hidden" />
                <Setter TargetName="PART_Grid" Property="Visibility" Value="Visible" />
                <Setter TargetName="TableLabel" Property="Text" Value="Chart" />
              </Trigger>
              <Trigger Property="IsZoomed" Value="True">
                <Setter TargetName="PART_Reset" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="Caption" Value="">
                <Setter TargetName="CaptionText" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="Subtitle" Value="">
                <Setter TargetName="SubtitleText" Property="Visibility" Value="Collapsed" />
              </Trigger>
              <Trigger Property="Notice" Value="">
                <Setter TargetName="NoticeText" Property="Visibility" Value="Collapsed" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

</ResourceDictionary>
