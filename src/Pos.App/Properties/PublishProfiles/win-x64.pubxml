<?xml version="1.0" encoding="utf-8"?>
<!--
  Lane deployment: one executable, no runtime to install first.

  NFR-04 allows requiring the .NET desktop runtime, but a self-contained build removes even that,
  which matters on a POSReady machine somebody else administers. IncludeNativeLibrariesForSelfExtract
  is not optional here — SQLite ships as a native library, and without it the single file builds
  cleanly and then fails to open the database at the till.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- WPF does not survive trimming. Disk is cheaper than a lane that will not start. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
