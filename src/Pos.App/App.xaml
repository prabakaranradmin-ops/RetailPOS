<Application x:Class="Pos.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          The look's colours: Night until the lane's settings say otherwise, when Looks.Apply swaps
          this for the chosen one. First, so the styles below find their colours from the start.
        -->
        <ResourceDictionary Source="Themes/Night.xaml" />

        <!-- Every font and style the windows bind to. See Theme.xaml for why it is split. -->
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
