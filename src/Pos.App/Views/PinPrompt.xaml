<Window x:Class="Pos.App.Views.PinPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetailPOS" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Surface}">

  <StackPanel Margin="28,24,28,22">
    <TextBlock Text="The owner's screen" FontSize="20" />
    <TextBlock x:Name="Message" Foreground="{StaticResource InkMuted}" FontSize="13" TextWrapping="Wrap"
               Margin="0,6,0,18"
               Text="This shows the shop's turnover, margins and cost prices. Type the PIN to open it." />

    <PasswordBox x:Name="Entry" Padding="10,8" FontSize="16" />

    <TextBlock x:Name="Problem" Foreground="#FFFF7A66" FontSize="13" TextWrapping="Wrap"
               Margin="0,10,0,0" Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" Padding="18,7" Margin="0,0,10,0" IsCancel="True" />
      <Button Content="Open" Padding="22,7" IsDefault="True" Click="Open_Click" />
    </StackPanel>
  </StackPanel>
</Window>
