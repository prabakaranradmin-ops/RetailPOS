<Window x:Class="Pos.App.Views.PinPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Pos.App"
        Title="RetailPOS" SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource Surface}" FontFamily="Segoe UI">

  <!--
    Styled by the theme like every other window. It used to get the system's buttons - pale grey,
    with the theme's white ink on them - because the dark ones were defined inside the owner's
    screen, which this window is not part of. 1.3:1: "Open" was all but invisible.
  -->
  <StackPanel Margin="28,24,28,22">
    <StackPanel Orientation="Horizontal">
      <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource IconChip}"
              VerticalAlignment="Center" Margin="0,0,14,0">
        <TextBlock Text="{x:Static app:Glyphs.Lock}" Style="{StaticResource Glyph}" FontSize="17" HorizontalAlignment="Center" />
      </Border>
      <TextBlock Text="The owner's screen" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>

    <TextBlock x:Name="Message" Foreground="{StaticResource InkMuted}" FontSize="13.5" TextWrapping="Wrap"
               Margin="0,14,0,16"
               Text="This shows the shop's turnover, margins and cost prices. Type the PIN to open it." />

    <PasswordBox x:Name="Entry" Padding="10,8" FontSize="16" AutomationProperties.Name="PIN" />

    <TextBlock x:Name="Problem" Foreground="{StaticResource Danger}" FontSize="13" TextWrapping="Wrap"
               Margin="0,10,0,0" Visibility="Collapsed" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="Cancel" Padding="18,8" Margin="0,0,10,0" IsCancel="True" />
      <Button Content="Open" Padding="22,8" IsDefault="True" Click="Open_Click"
              Style="{StaticResource PrimaryButton}" />
    </StackPanel>
  </StackPanel>
</Window>
