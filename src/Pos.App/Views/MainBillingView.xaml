<Window x:Class="Pos.App.Views.MainBillingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Pos.App.ViewModels"
        xmlns:v="clr-namespace:Pos.App.Views"
        xmlns:app="clr-namespace:Pos.App"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="RetailPOS — Billing"
        Language="en-IN"
        WindowState="Maximized"
        Background="{DynamicResource AppBackdrop}"
        FontFamily="Segoe UI">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <vm:TenderTypeLabelConverter x:Key="TenderLabel" />
    <v:PluralConverter x:Key="Plural" />
    <v:ShowConverter x:Key="Show" />

    <!--
      Money and quantities line up on the decimal point, so a column of figures scans down, and they
      are set in a monospaced face so a digit does not shift position as the value changes.
    -->
    <Style x:Key="NumericCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FontFamily" Value="{StaticResource FigureFont}" />
    </Style>

    <!-- The printed price, which is context rather than the figure being charged. -->
    <Style x:Key="MutedNumericCell" TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
      <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
    </Style>

    <!-- What this line comes to: the figure a customer follows down the screen. -->
    <Style x:Key="TotalCell" TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
      <Setter Property="Foreground" Value="{DynamicResource Positive}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--
      Money off, and never the same colour as money taken: amber, as it is in the bill card and
      beside the total. It was red here and green there - one saving, two colours, one of them the
      colour of a mistake.
    -->
    <Style x:Key="DiscountCell" TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
      <Setter Property="Foreground" Value="{DynamicResource Saving}" />
    </Style>

    <!--
      A pane over the billing screen: a card lifted off the dimmed screen by its lighter, lit-from-
      above fill and its rim. No shadow effect: an effect renders everything inside it as a picture,
      and the figures and the UPI code in a pane are the last things to soften.
    -->
    <Style x:Key="PaneCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardFill}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardEdge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="26,24" />
    </Style>

    <!--
      The dimmed layer a pane sits on. PaneInset is the foot of the screen - the message bar and the
      keys - which the card is kept above; the view measures it (MainBillingView.FitPanes).
    -->
    <sys:Double x:Key="PaneInset">0</sys:Double>
    <Style TargetType="v:PaneScrim">
      <Setter Property="Background" Value="{DynamicResource Scrim}" />
      <Setter Property="BottomInset" Value="{DynamicResource PaneInset}" />
    </Style>

    <!--
      The keys at the foot of a pane: what the pane's own keys do, where the cashier is looking.
      The confirm and back keys are bound from the keymap, so a lane that rebinds them reads its own.
    -->
    <Style x:Key="PaneKeys" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,14,0,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The icon at the head of a pane, in its tinted square. -->
    <Style x:Key="PaneBadge" TargetType="Border">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource IconChip}" />
      <Setter Property="Margin" Value="0,0,14,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      A key along the bottom: the key in its cap, what it does beside it. A button now, so a click
      does what the key does - they looked like buttons before and did nothing when pressed. Never
      takes the keyboard: the caret stays in the scan box however the key is reached.
    -->
    <Style x:Key="KeyPillButton" TargetType="Button">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="{DynamicResource ChipFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="6" Padding="6,4,9,4">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource ButtonFaceHover}" />
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource ButtonEdgeHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource RowActive}" />
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </Trigger>
              <!-- Closing the day cannot be undone: its key is in the danger colour, set apart from "New". -->
              <DataTrigger Binding="{Binding IsDanger}" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="#80F87171" />
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource DangerSoft}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsDanger}" Value="True">
          <Setter Property="Margin" Value="14,0,6,6" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- The message bar's colours, one set per kind of message. -->
    <Style x:Key="MessageBar" TargetType="Border">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource InfoSoft}" />
      <Setter Property="BorderBrush" Value="#4038BDF8" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="Done">
          <Setter Property="Background" Value="{DynamicResource DoneSoft}" />
          <Setter Property="BorderBrush" Value="#4034D399" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
          <Setter Property="Background" Value="{DynamicResource WarningSoft}" />
          <Setter Property="BorderBrush" Value="#59F5B544" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
          <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
          <Setter Property="BorderBrush" Value="#66F87171" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusMessage}" Value="">
          <Setter Property="Visibility" Value="Hidden" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MessageInk" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="Done">
          <Setter Property="Foreground" Value="{DynamicResource Done}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
          <Setter Property="Foreground" Value="{DynamicResource Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
          <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MessageIcon" TargetType="TextBlock" BasedOn="{StaticResource MessageInk}">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Text" Value="{x:Static app:Glyphs.Info}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding StatusKind}" Value="Done">
          <Setter Property="Text" Value="{x:Static app:Glyphs.Done}" />
          <Setter Property="Foreground" Value="{DynamicResource Done}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
          <Setter Property="Text" Value="{x:Static app:Glyphs.Warning}" />
          <Setter Property="Foreground" Value="{DynamicResource Warning}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding StatusKind}" Value="Error">
          <Setter Property="Text" Value="{x:Static app:Glyphs.Error}" />
          <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="IndexCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource FigureFont}" />
      <Setter Property="Foreground" Value="{DynamicResource InkDim}" />
    </Style>

    <Style x:Key="NameCell" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />

      <!-- A name too long for its column ends in an ellipsis rather than stopping mid-letter. -->
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Codes: present when wanted, quiet when not. -->
    <Style x:Key="DimCell" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}" />
      <Setter Property="FontFamily" Value="{StaticResource FigureFont}" />
      <Setter Property="FontSize" Value="13" />
    </Style>

  </Window.Resources>

  <Grid x:Name="Screen" Margin="16,10,16,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--
      What this lane is. Which build, whose shop, which till, and that nothing it does leaves the
      machine — the last of which a cashier is entitled to know and nothing else on screen says.
      Said quietly: "OFFLINE" in bright green read like a fault light, when it is the normal state.
    -->
    <Grid Grid.Row="0" Margin="2,0,2,10">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Border Width="26" Height="26" CornerRadius="7" VerticalAlignment="Center" Margin="0,0,10,0">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF38BDF8" Offset="0" />
              <GradientStop Color="#FF10B981" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <!-- The mark is the same in every look, so its glyph is too: dark on the sky-to-green. -->
          <TextBlock Text="{x:Static app:Glyphs.Till}" Style="{StaticResource Glyph}" FontSize="13"
                     Foreground="#FF04121C" HorizontalAlignment="Center" />
        </Border>
        <TextBlock x:Name="ShopName" Text="" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="RetailPOS" Foreground="{DynamicResource InkDim}" FontSize="12"
                   Margin="10,1,0,0" VerticalAlignment="Center" />
        <Border Background="#1438BDF8" BorderBrush="#4038BDF8" BorderThickness="1"
                CornerRadius="5" Padding="7,1" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock x:Name="BuildChip" Text="GST" FontSize="10.5" FontWeight="Bold"
                     Foreground="{DynamicResource Accent}" />
        </Border>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Border Background="{DynamicResource ChipFill}" CornerRadius="5" Padding="8,2" VerticalAlignment="Center">
          <TextBlock x:Name="LaneLabel" Text="" Foreground="{DynamicResource InkMuted}" FontSize="11.5" />
        </Border>
        <Ellipse Width="7" Height="7" Fill="{DynamicResource Positive}" Margin="14,0,7,0"
                 VerticalAlignment="Center" />
        <TextBlock Text="Works offline · nothing leaves this machine" Foreground="{DynamicResource InkMuted}"
                   FontSize="11.5" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Search: one box for both typed queries and scanner bursts (SRS 2.1). -->
    <Border Grid.Row="1" Style="{StaticResource CardPanel}" Padding="14,10,14,12" CornerRadius="10">
      <StackPanel>
        <TextBlock Text="Scan or search" Foreground="{DynamicResource InkMuted}" FontSize="12" />
        <Grid Margin="0,5,0,0">
          <TextBox x:Name="SearchBox"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="24"
                   Padding="44,6,8,6"
                   Foreground="{DynamicResource Ink}"
                   CaretBrush="{DynamicResource Accent}"
                   AutomationProperties.Name="Scan or search" />
          <TextBlock Text="{x:Static app:Glyphs.Search}" Style="{StaticResource Glyph}" FontSize="19"
                     Foreground="{DynamicResource InkMuted}" Margin="16,0,0,0" HorizontalAlignment="Left"
                     IsHitTestVisible="False" />
          <TextBlock Text="Scan a barcode, or type part of a name" Margin="46,0,0,0" FontSize="17"
                     Foreground="{DynamicResource InkDim}" VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>

        <!-- Result list, shown only when a query matched more than one item. -->
        <ListBox AutomationProperties.Name="Items matching the search" x:Name="ResultList"
                 Margin="0,8,0,0"
                 MaxHeight="180"
                 Background="{DynamicResource Surface}"
                 BorderBrush="{DynamicResource Line}"
                 Focusable="False"
                 ItemsSource="{Binding SearchResults}"
                 SelectedIndex="{Binding SelectedResultIndex, Mode=TwoWay}"
                 Visibility="{Binding IsResultListOpen, Converter={StaticResource BoolToVisibility}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <!-- The Tamil name beside the English, so an item found by it shows why it was found. -->
                <TextBlock Grid.Column="0" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding NameTa, Mode=OneWay}" Foreground="{DynamicResource InkMuted}" />
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding Sku}" Foreground="{DynamicResource InkMuted}" />
                <TextBlock Grid.Column="2" Text="{Binding SellPrice, StringFormat={}{0:N2}}"
                           HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <!-- Line grid and totals. -->
    <Grid Grid.Row="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />

        <!-- Widened when the panel gained its sections: two labelled figures side by side in the
             payment block do not fit 320 without the numbers touching their own labels. -->
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

      <!-- The bill, on a card like the panel beside it, so the two read as one surface in two parts. -->
      <Border Grid.Column="0" Style="{StaticResource CardPanel}" Padding="6,4,6,6" CornerRadius="10">
      <Grid>
      <DataGrid AutomationProperties.Name="The bill" x:Name="LineGrid"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                Background="Transparent"
                RowBackground="Transparent"
                Foreground="{DynamicResource Ink}"
                BorderThickness="0"
                HorizontalGridLinesBrush="{DynamicResource Line}"
                AlternationCount="2"
                AlternatingRowBackground="{DynamicResource RowStripe}"
                FontSize="14"
                RowHeight="28"
                ItemsSource="{Binding Lines}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedIndex="{Binding SelectedLineIndex, Mode=TwoWay}">
        <!--
          Every column is Auto, so the grid measures its own headers and cells rather than
          trusting a width somebody guessed.

          This is not a style preference. Hand-picked widths were clipping figures: a quantity of
          1.25 rendered as ".25" because the cell was a few pixels short and the text is
          right-aligned, so it overflowed and was cut on the left. A price that reads wrong on a
          till is worse than a column that shifts by a few pixels when the widest value changes,
          and no amount of picking better numbers makes the whole class of fault go away.

          The item name is starred, so it takes whatever is left over and the columns always reach
          the edge of the grid.

          That failed twice before, and this is why. A * column claims the leftover width before the
          Auto columns have finished measuring, so the name took an over-generous share and Disc
          through Total came out as slivers a few pixels wide. The missing piece was not the star —
          it was that none of the other columns had a floor. Every one now carries a MinWidth wide
          enough for its own header and its widest realistic value, so nothing can be squeezed below
          legibility however the measure pass falls out. If the total ever does exceed the screen,
          the grid scrolls sideways.

          The alternative, tried and removed, was an empty trailing column to soak up the slack. It
          worked, but it left a nameless column in the header that everyone asked about.

          Sideways scrolling is off for the same reason. With a starred column that shrinks to a
          floor, the widths always add up to the space available and there is nothing to scroll to —
          the scrollbar was left over from when every column was content-sized, and it went on
          appearing for a rounding pixel or two.

          There are no per-line tax columns. The rate-wise breakup a GST invoice must carry is on
          the printed invoice, where the law wants it, and in the day-end report — not on a screen a
          cashier reads with a customer waiting. Taking them off is what lets both builds share one
          grid: nothing to hide on the no-tax lane, and four columns less to crowd the figures that
          are actually read.
        -->
        <DataGrid.Columns>
          <!-- Line number, so a cashier and a customer can point at the same row. -->
          <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="Auto" MinWidth="36"
                              ElementStyle="{StaticResource IndexCell}" />

          <!--
            The name takes the slack, so the columns always reach the edge of the grid.

            Capped as well as floored. Uncapped, the star claimed its share of the width before the
            Auto columns had finished measuring, so the two together came to more than the viewport
            and the grid scrolled with Total half off the edge. The cap leaves the Autos room to
            turn out wider than expected without pushing anything off.
          -->
          <DataGridTextColumn x:Name="ItemColumn" Header="Item" Binding="{Binding Name}" Width="*" MinWidth="220" MaxWidth="520"
                              ElementStyle="{StaticResource NameCell}" />

          <!--
            HSN and barcode show only where there is room for them. Together they take 190 pixels
            that nobody reads at the counter - the printed bill carries the HSN - and on a till
            narrower than about 1280 they pushed the line total, the one figure a customer checks,
            off the right-hand edge. The view hides them below a width it measures; see
            MainBillingView.FitColumns.
          -->
          <DataGridTextColumn x:Name="HsnColumn" Header="HSN" Binding="{Binding Hsn}" Width="Auto" MinWidth="58"
                              ElementStyle="{StaticResource DimCell}" />

          <!-- "Barcode" alone: the header was setting this column's width, not its values. -->
          <DataGridTextColumn x:Name="BarcodeColumn" Header="Barcode" Binding="{Binding BarcodeOrBatch}" Width="Auto" MinWidth="132"
                              ElementStyle="{StaticResource DimCell}" />
          <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="Auto" MinWidth="60"
                              ElementStyle="{StaticResource NumericCell}" />
          <DataGridTextColumn Header="Unit" Binding="{Binding UnitLabel}" Width="Auto" MinWidth="52"
                              ElementStyle="{StaticResource DimCell}" />
          <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat={}{0:N2}}" Width="Auto" MinWidth="84"
                              ElementStyle="{StaticResource MutedNumericCell}" />
          <!--
            The unit rate without tax (SRS 2.2). Headed "Rate" it read as a discounted price - 180.00
            under an MRP of 189.00 - so it says what it is; the view heads it "Price" on a lane that
            charges no GST. It is the first figure to go on a very narrow screen: the printed bill
            carries it, and the line total must never be the one that falls off.
          -->
          <DataGridTextColumn x:Name="RateColumn" Header="Before GST" Binding="{Binding UnitRateExclTax, StringFormat={}{0:N2}}" Width="Auto" MinWidth="96"
                              ElementStyle="{StaticResource NumericCell}" />

          <!-- A dash where there is no discount: a column of 0.00 reads as a figure worth checking. -->
          <DataGridTextColumn Header="Disc" Binding="{Binding DiscountLabel}" Width="Auto" MinWidth="72"
                              ElementStyle="{StaticResource DiscountCell}" />
          <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="Auto" MinWidth="92"
                              ElementStyle="{StaticResource TotalCell}" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- An empty bill says what to do, rather than showing a header over nothing. -->
      <StackPanel x:Name="EmptyBill" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,30,0,0">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Lines.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource IconChip}" HorizontalAlignment="Center">
          <TextBlock Text="{x:Static app:Glyphs.Cart}" Style="{StaticResource Glyph}" FontSize="30"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Ready for the first item" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Scan a barcode, or type part of a name in the box above." FontSize="13"
                   Foreground="{DynamicResource InkMuted}" Margin="0,6,0,0" HorizontalAlignment="Center" />
      </StackPanel>
      </Grid>
      </Border>

      <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource CardPanel}" Padding="16" CornerRadius="10">
        <!--
          Docked, not stacked. This panel sits beside a grid that gets shorter whenever the search
          results open under the scan box, and as one tall StackPanel it overran the bottom edge in
          that state — the cashier's name was cut in half. Docking the figures to the top and the
          customer and cashier to the bottom means both blocks always get their space and the
          slack falls in the middle, where there is nothing to lose.
        -->
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">

            <!-- NFR-02: the grand total is the one figure that must read across the counter, so it
                 takes the top of the panel rather than whatever the other sections leave over. -->
            <Border Background="{DynamicResource TotalFill}" BorderBrush="#6610B981" BorderThickness="1"
                    CornerRadius="10" Padding="14,11" Margin="0,0,0,10">
              <StackPanel>
                <Grid>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="{x:Static app:Glyphs.Cart}" Style="{StaticResource Glyph}" FontSize="12"
                               Foreground="{DynamicResource Positive}" Margin="0,0,7,0" />
                    <TextBlock Text="TOTAL" Style="{StaticResource SectionHeading}" Foreground="{DynamicResource InkMuted}"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <Border Background="{DynamicResource ChipFillStrong}" CornerRadius="9" Padding="8,1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Totals.LineCount, StringFormat={}{0} lines}"
                               Foreground="{DynamicResource InkMuted}" FontSize="11" />
                  </Border>
                </Grid>

                <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N2}}"
                           Foreground="{DynamicResource Positive}"
                           FontFamily="{StaticResource FigureFont}"
                           FontSize="38"
                           FontWeight="Bold"
                           TextAlignment="Right"
                           LineHeight="44"
                           Margin="0,4,0,2"
                           LineStackingStrategy="BlockLineHeight" />

                <!--
                  Only when the bill was actually rounded. The cashier is the one a customer asks
                  why the figure is not what they added up in their head, so the paise that came
                  off is on the screen rather than only on the paper - each figure with its own name,
                  where it used to be two numbers under one label.
                -->
                <Grid Visibility="{Binding HasRoundOff, Converter={StaticResource BoolToVisibility}}"
                      Margin="0,0,0,2">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Before rounding" Foreground="{DynamicResource InkDim}" FontSize="11.5" HorizontalAlignment="Left" />
                  <TextBlock Foreground="{DynamicResource InkDim}" FontSize="11.5" HorizontalAlignment="Right"
                             FontFamily="{StaticResource FigureFont}"
                             Text="{Binding TotalBeforeRounding, Mode=OneWay, StringFormat={}{0:N2}}" />
                  <TextBlock Grid.Row="1" Text="Round off" Foreground="{DynamicResource InkDim}" FontSize="11.5" HorizontalAlignment="Left" />
                  <TextBlock Grid.Row="1" Foreground="{DynamicResource InkDim}" FontSize="11.5" HorizontalAlignment="Right"
                             FontFamily="{StaticResource FigureFont}"
                             Text="{Binding RoundOff, Mode=OneWay, StringFormat={}{0:+0.00;−0.00}}" />
                </Grid>

                <Grid Margin="0,3,0,0">
                  <TextBlock x:Name="TaxNote" Text="Incl. all taxes" Foreground="{DynamicResource InkDim}"
                             FontSize="11.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                  <Border HorizontalAlignment="Right" CornerRadius="9" Padding="8,1" Background="#1FF5B544">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding SavingsLabel}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource Saving}" FontSize="11.5" FontWeight="SemiBold"
                               Text="{Binding SavingsLabel}" />
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!--
            Who is on the till, docked to the bottom so a shift change is always in view.
          -->
          <StackPanel DockPanel.Dock="Bottom">
            <Separator Margin="0,9" Background="{DynamicResource Line}" />

            <TextBlock Text="LANE" Style="{StaticResource SectionHeading}" Margin="0,0,0,5" />

            <!--
              Two compact rows rather than two headed blocks. As headings with large values under
              them these two took a third of the panel's height, and what they pushed off the
              bottom was the payment split — the section a cashier actually reads while counting
              out change.
            -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CustomerLabel}"
                         Style="{StaticResource FieldValue}" FontSize="15" />

              <!-- What they already owe, only when they owe something: the moment it can be
                   mentioned is while they are standing at the counter. -->
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Owes on khata" Style="{StaticResource FieldLabel}"
                         Visibility="{Binding CustomerOwesAnything, Converter={StaticResource BoolToVisibility}}" />
              <StackPanel Grid.Row="1" Grid.Column="1"
                          Visibility="{Binding CustomerOwesAnything, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding CustomerOwes, StringFormat={}{0:N2}}"
                           Style="{StaticResource FieldValue}" FontSize="15" Foreground="{DynamicResource Negative}" />
                <!-- Their limit and when they last paid: what to know before putting more on it. -->
                <TextBlock Text="{Binding CustomerKhataNote}" Foreground="{DynamicResource InkMuted}" FontSize="12"
                           HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right"
                           Visibility="{Binding HasCustomerKhataNote, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Cashier" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CashierLabel}"
                         Style="{StaticResource FieldValue}" FontSize="15" />
            </Grid>
          </StackPanel>

          <!--
            The sections in the middle scroll.

            Between them they are taller than the panel on a 1030px window, and the first attempt at
            this simply let the bottom run off the edge — the points row was cut in half and the
            cashier's name was gone. The two things that must never be missing are docked outside
            this: the total above, because NFR-02 makes it the figure that has to read across a
            counter, and the cashier below, because a bill has to be attributable.
          -->
          <!-- Padded on the right so a right-aligned figure does not sit under the scrollbar. -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Padding="0,0,12,0">
            <StackPanel>

            <!-- INVOICE -->
            <TextBlock Text="INVOICE" Style="{StaticResource SectionHeading}" Margin="0,0,0,6" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- "Last bill" while the screen is empty: the number is the one just settled, not this one. -->
              <TextBlock Grid.Row="0" Grid.Column="0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                    <Setter Property="Text" Value="Bill" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowingLastInvoiceNo}" Value="True">
                        <Setter Property="Text" Value="Last bill" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InvoiceNoLabel}" Style="{StaticResource FieldValue}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Date" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TodayLabel}" Style="{StaticResource FieldValue}" />
            </Grid>

            <!--
              BILL

              Discount only. The taxable value and the CGST/SGST split used to sit here and are
              gone from this screen entirely, along with the four per-line tax columns: the
              rate-wise figures a GST return is filed from live on the printed invoice and in the
              day-end report, which is where they are needed and checked. What a cashier needs at
              the counter is what came off the price.
            -->
            <!-- Each section below shows only when it has something in it (HasDiscount). -->
            <StackPanel Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="BILL" Style="{StaticResource SectionHeading}" Margin="0,11,0,5" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="Discount" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                         Foreground="{DynamicResource Saving}"
                         Text="{Binding Totals.TotalDiscount, StringFormat={}−{0:N2}}" />
            </Grid>
            </StackPanel>

            <!-- PAYMENT -->
            <StackPanel x:Name="PaymentSection" Visibility="{Binding HasPayments, Converter={StaticResource BoolToVisibility}}">
            <Separator Margin="0,10" Background="{DynamicResource Line}" />
            <TextBlock Text="PAYMENT" Style="{StaticResource SectionHeading}" Margin="0,0,0,6" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Cash" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldValue}" Margin="0,1,14,1"
                         Text="{Binding TenderedCash, StringFormat={}{0:N2}}" />
              <TextBlock Grid.Row="0" Grid.Column="2" Text="UPI" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Row="0" Grid.Column="3" Style="{StaticResource FieldValue}"
                         Text="{Binding TenderedUpi, StringFormat={}{0:N2}}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Card" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldValue}" Margin="0,1,14,1"
                         Text="{Binding TenderedCard, StringFormat={}{0:N2}}" />
              <TextBlock Grid.Row="1" Grid.Column="2" Text="Khata" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource FieldValue}"
                         Text="{Binding TenderedCredit, StringFormat={}{0:N2}}" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Change" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Style="{StaticResource FieldValue}"
                         Foreground="{DynamicResource Positive}"
                         Text="{Binding ChangeDue, StringFormat={}{0:N2}}" />
            </Grid>
            </StackPanel>

            <!-- POINTS -->
            <StackPanel x:Name="PointsSection" Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="POINTS" Style="{StaticResource SectionHeading}" Margin="0,11,0,5" />

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="Earning" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Column="1" Text="{Binding PointsEarning}" Style="{StaticResource FieldValue}" Margin="0,1,14,1" />
              <TextBlock Grid.Column="2" Text="Balance" Style="{StaticResource FieldLabel}" />
              <TextBlock Grid.Column="3" Text="{Binding LoyaltyBalance}" Style="{StaticResource FieldValue}" />
            </Grid>
            </StackPanel>

            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="3">
      <!-- In-place editor for the two editable cells. -->
      <Border Margin="0,12,0,0" Padding="14,10"
              Style="{StaticResource CardPanel}" BorderBrush="{DynamicResource Accent}"
              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding EditingColumn}" FontSize="18" VerticalAlignment="Center"
                     Foreground="{DynamicResource Accent}" />
          <TextBox x:Name="EditBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{Binding EditingColumn, StringFormat='The line: new {0}'}"
                   Width="180" FontSize="20" Margin="12,0,0,0" Padding="6,4" />
        </StackPanel>
      </Border>

      <!-- What an order asked for that is not on the bill, kept in view until the order is saved or Esc. -->
      <Border x:Name="OrderMissesPanel" Margin="0,12,0,0" Padding="14,9" CornerRadius="10" BorderThickness="1"
              Background="{DynamicResource WarningSoft}" BorderBrush="#59F5B544"
              Visibility="{Binding HasOrderMisses, Converter={StaticResource BoolToVisibility}}"
              AutomationProperties.Name="{Binding OrderMissesLine, StringFormat='Not on the bill from the order: {0}'}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Static app:Glyphs.Warning}" Style="{StaticResource Glyph}" Foreground="{DynamicResource Warning}"
                     FontSize="14" Margin="0,2,10,0" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource Warning}">
            <Run Text="Not on the bill from the order:" FontWeight="SemiBold" /> <Run Text="{Binding OrderMissesLine, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Grid.Column="2" Text="{Binding CancelKey, StringFormat='{}{0} hides this'}" FontSize="12"
                     Foreground="{DynamicResource InkDim}" Margin="12,2,0,0" VerticalAlignment="Top" />
        </Grid>
      </Border>
    </StackPanel>

    <!--
      Status line, and the keys.

      The keys were one long run of text along the bottom, which reads as a sentence and scans as
      nothing. As separated pills each key is findable at a glance, and F12 sits apart at the right
      because it is the one that takes money.
    -->
    <!--
      The message bar.

      It used to be one line of blue text, trimmed with "…" - so "paste it into a message to 950001…"
      lost the number it was telling the cashier to use - and it sat under the dark overlay whenever a
      pane was open, 1.18:1, so "statement printed" could not be read by the person who had just
      printed it. It now wraps to three lines, takes the colour and icon of what it is saying (done,
      held up, refused - MessageKinds), and is drawn above the panes so it can always be read.

      Hidden rather than collapsed when there is nothing to say, so the bill above does not jump up
      and down by a line every time a message comes and goes.
    -->
    <StackPanel x:Name="MessageArea" Grid.Row="4" Panel.ZIndex="20">
      <!--
        What still needs doing about the last sale - the receipt that did not print, what the
        customer now owes - kept above the bar until the next bill starts, so the next message does
        not wipe it before anybody has acted on it.
      -->
      <Border x:Name="StandingNotePanel" Margin="0,10,0,0" Padding="12,6" CornerRadius="8" BorderThickness="1"
              Background="{DynamicResource WarningSoft}" BorderBrush="#59F5B544"
              Visibility="{Binding ShowsStandingNote, Converter={StaticResource BoolToVisibility}}"
              AutomationProperties.Name="{Binding StandingNote, StringFormat='From the last sale: {0}'}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{x:Static app:Glyphs.Warning}" Style="{StaticResource Glyph}" Foreground="{DynamicResource Warning}"
                     FontSize="13" Margin="0,2,10,0" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" FontSize="13"
                     Foreground="{DynamicResource Warning}">
            <Run Text="Last sale:" FontWeight="SemiBold" /> <Run Text="{Binding StandingNote, Mode=OneWay}" />
          </TextBlock>
        </Grid>
      </Border>

      <Border x:Name="MessageStrip" Margin="0,10,0,0" MinHeight="36" Style="{StaticResource MessageBar}"
              AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding StatusMessage}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource MessageIcon}" VerticalAlignment="Top" Margin="0,2,10,0" />
          <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource MessageInk}" FontSize="14"
                     TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </StackPanel>

    <Grid x:Name="KeyStrip" Grid.Row="5" Margin="0,8,0,0">
      <Border Style="{StaticResource CardPanel}" CornerRadius="10" Padding="8,8,8,2">
        <!--
          Two columns, not one cell. The pills and Pay & Print used to share a single cell, the pills
          left and Pay right, so the pills were measured against the whole width and, once there were
          enough of them, ran underneath Pay instead of wrapping: adding F8 hid "Close day" behind
          it. In their own column the pills stop where Pay begins and wrap to a second line on a
          narrow screen. LayoutFitTests checks that no pill sits under Pay.
        -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <ItemsControl x:Name="KeyPills" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource KeyPillButton}" Click="KeyPill_Click" ToolTip="{Binding Label}"
                        AutomationProperties.Name="{Binding Spoken}">
                  <StackPanel Orientation="Horizontal">
                    <Border Background="{DynamicResource KeyCapFill}" BorderBrush="{DynamicResource KeyCapEdge}" BorderThickness="1,1,1,2" CornerRadius="4" Padding="5,0">
                      <TextBlock x:Name="Cap" Text="{Binding Key}" Foreground="{DynamicResource Accent}"
                                 FontFamily="{StaticResource FigureFont}" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock x:Name="What" Text="{Binding Label}" Foreground="{DynamicResource InkMuted}"
                               FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding IsDanger}" Value="True">
                    <Setter TargetName="Cap" Property="Foreground" Value="{DynamicResource Danger}" />
                    <Setter TargetName="What" Property="Foreground" Value="{DynamicResource Danger}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The one that takes money, kept apart from the ones that do not, and the brightest thing on the strip. -->
          <Button x:Name="PayPill" Grid.Column="1" Focusable="False" IsTabStop="False" Cursor="Hand"
                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,6" Click="PayPill_Click"
                  AutomationProperties.Name="F12, Pay and print">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Face" Background="{DynamicResource PayFill}" CornerRadius="8" Padding="10,7,14,7">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Face" Property="Opacity" Value="0.88" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
            <StackPanel Orientation="Horizontal">
              <Border Background="#33FFFFFF" CornerRadius="4" Padding="6,1">
                <TextBlock Text="F12" Foreground="{DynamicResource OnAccent}" FontFamily="{StaticResource FigureFont}"
                           FontSize="12" FontWeight="Bold" />
              </Border>
              <TextBlock Text="Pay &amp; Print" Foreground="{DynamicResource OnAccent}" FontSize="14"
                         FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- Tender pane, over the whole screen while taking payment (SRS 2.4). -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsTendering, Converter={StaticResource BoolToVisibility}}">
      <Border Width="940" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource PaneBadge}">
                <TextBlock Text="{x:Static app:Glyphs.Card}" Style="{StaticResource Glyph}" FontSize="17" HorizontalAlignment="Center" />
              </Border>
              <TextBlock Text="Payment" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
              <TextBlock Text="DUE" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkMuted}"
                         VerticalAlignment="Center" Margin="0,4,10,0" />
              <TextBlock FontSize="28" FontWeight="Bold" FontFamily="{StaticResource FigureFont}"
                         Text="{Binding AmountDue, StringFormat={}{0:N2}}" />
            </StackPanel>
          </Grid>

          <!-- Tender types. Arrows move; typing an amount and committing takes the payment. -->
          <ListBox AutomationProperties.Name="Tenders" Margin="0,18,0,0"
                   Background="{DynamicResource FieldFill}"
                   BorderBrush="{DynamicResource CardEdge}"
                   Padding="2,4,2,0"
                   Focusable="False"
                   ItemContainerStyle="{StaticResource SegmentItem}"
                   ItemsSource="{Binding TenderTypes}"
                   SelectedIndex="{Binding SelectedTenderTypeIndex, Mode=TwoWay}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource TenderLabel}}"
                           HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!--
            Two columns: the amount and what has been taken on the left, the UPI code on the right.

            The code used to sit under the amount box with the payments and the two totals under
            it, which made this the tallest pane on the till - on a 1366×768 screen "Still due"
            and "Change" ended up under the message bar. Beside each other the two halves come to
            the height of the taller, and the figures the cashier reads out stay in view.
          -->
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedTenderType, Converter={StaticResource TenderLabel}}"
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="110" MaxWidth="150"
                           Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,0,14,0" />
                <TextBox x:Name="TenderBox" Grid.Column="1" MaxWidth="260" HorizontalAlignment="Left" MinWidth="200"
                         Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding SelectedTenderType, Converter={StaticResource TenderLabel}, StringFormat='Amount by {0}'}"
                         FontSize="24" Padding="10,6" FontFamily="{StaticResource FigureFont}" />
              </Grid>

              <!-- The points line only for points: it read under every tender, as if cash were counted in points. -->
              <TextBlock Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Leave blank to take the whole balance." />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding SelectedTenderType}" Value="LoyaltyPoints">
                        <Setter Property="Text" Value="Type the points to redeem, not rupees. Leave blank for as many as the bill allows." />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <!-- Taken on the phone instead of paper: said plainly, so nobody waits for a bill to print. -->
              <Border Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="{DynamicResource DoneSoft}"
                      BorderBrush="{DynamicResource Positive}" BorderThickness="1"
                      Visibility="{Binding IsPaperless, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding PaperlessLine, Mode=OneWay}" Foreground="{DynamicResource Positive}"
                           FontSize="14" TextWrapping="Wrap" />
              </Border>

              <TextBlock Margin="0,12,0,0" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}"
                         Text="{Binding UpiHint, Mode=OneWay}"
                         Visibility="{Binding HasUpiHint, Converter={StaticResource BoolToVisibility}}" />

              <!-- Payments taken so far. -->
              <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Payments}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Margin="0,0,10,0">
                        <Run Text="{x:Static app:Glyphs.Check}" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Positive}" FontSize="11" />
                        <Run Text=" " /><Run Text="{Binding Type, Converter={StaticResource TenderLabel}, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Grid.Column="1" Text="{Binding ReferenceNo}" Foreground="{DynamicResource InkMuted}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:N2}}" Margin="10,0,0,0"
                                 FontFamily="{StaticResource FigureFont}" HorizontalAlignment="Right" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Separator Margin="0,12" Background="{DynamicResource Line}" />

              <Grid x:Name="PaneTotals">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="STILL DUE" Foreground="{DynamicResource InkMuted}" FontSize="11" FontWeight="Bold" />
                  <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="42">
                    <TextBlock Text="{Binding AmountRemaining, StringFormat={}{0:N2}}" FontSize="32" FontWeight="Bold"
                               FontFamily="{StaticResource FigureFont}" />
                  </Viewbox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="CHANGE" Foreground="{DynamicResource InkMuted}" FontSize="11" FontWeight="Bold" TextAlignment="Right" />
                  <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Height="42">
                    <TextBlock Text="{Binding ChangeDue, StringFormat={}{0:N2}}" FontSize="32" FontWeight="Bold"
                               FontFamily="{StaticResource FigureFont}" Foreground="{DynamicResource Positive}" />
                  </Viewbox>
                </StackPanel>
              </Grid>
            </StackPanel>

            <!-- UPI: the code with the exact amount, for the customer to scan from the screen. Black on
                 white whatever the theme - a phone camera reads that best. -->
            <Border x:Name="UpiPanel" Grid.Column="1" Margin="22,0,0,0" Padding="14" CornerRadius="10" Background="White"
                    Width="420" VerticalAlignment="Top"
                    Visibility="{Binding ShowsUpiQr, Converter={StaticResource BoolToVisibility}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <v:QrCodeView x:Name="UpiCode" Text="{Binding UpiQr, Mode=OneWay}" Width="190" Height="190" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Scan to pay with any UPI app" Foreground="#FF333333" FontSize="13" TextWrapping="Wrap" />
                  <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="40" Margin="0,4,0,2">
                    <TextBlock Text="{Binding UpiCaption, Mode=OneWay}" Foreground="Black" FontSize="30" FontWeight="Bold"
                               FontFamily="{StaticResource FigureFont}" />
                  </Viewbox>
                  <TextBlock Text="{Binding UpiPayeeLine, Mode=OneWay}" Foreground="#FF333333" FontSize="12"
                             TextWrapping="Wrap" />
                  <TextBlock Foreground="#FF555555" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                             Text="{Binding CommitKey, StringFormat='Press {0} once their app says it is paid. Ctrl+Q prints the code on a slip.'}" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="Type the amount  ·  {0} takes it  ·  ↑ ↓ or ← → another tender  ·  Delete removes the last payment  ·  {1} back to the bill">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!-- Customer lookup by mobile number. -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsFindingCustomer, Converter={StaticResource BoolToVisibility}}">
      <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <TextBlock Text="Customer" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="{Binding CustomerPrompt, Mode=OneWay}" Foreground="{DynamicResource InkMuted}"
                     FontSize="12" Margin="0,12,0,0" />
          <TextBox x:Name="CustomerBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Customer's mobile number or name"
                   FontSize="24" Padding="8,6" Margin="0,4,0,0" />

          <!--
            Customers the shop already knows, matched on name or number as it is typed. Picked with
            the arrow keys, like the item results; nothing is highlighted until an arrow is pressed,
            so a new number that shares digits with somebody else's cannot be committed onto them.
          -->
          <ListBox AutomationProperties.Name="Customers matching" ItemsSource="{Binding CustomerMatches}"
                   SelectedIndex="{Binding SelectedCustomerMatchIndex, Mode=OneWay}"
                   Visibility="{Binding HasCustomerMatches, Converter={StaticResource BoolToVisibility}}"
                   Focusable="False" Margin="0,10,0,0" MaxHeight="230"
                   ItemContainerStyle="{StaticResource TintedListItem}"
                   Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource CardEdge}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontSize="15" TextTrimming="CharacterEllipsis"
                             Text="{Binding Name, TargetNullValue='(no name)'}" />
                  <TextBlock Grid.Column="1" FontSize="15" Margin="12,0,0,0"
                             FontFamily="{StaticResource FigureFont}" Text="{Binding MobileNo}" />
                  <TextBlock Grid.Column="2" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"
                             Text="{Binding LoyaltyBalance, StringFormat={}{0} pts}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="↑ ↓ choose  ·  {0} puts them on the bill, or saves a new number  ·  {1} back">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!-- Reprint a past invoice. -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsReprinting, Converter={StaticResource BoolToVisibility}}">
      <Border Width="600" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <TextBlock Text="Reprint a bill" FontSize="22" FontWeight="Bold" />
          <TextBlock Foreground="{DynamicResource InkMuted}" FontSize="13" Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     Text="Leave blank for the last bill on this lane, or type an invoice number or the customer's mobile number." />
          <TextBox x:Name="ReprintBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Bill to reprint: invoice number or mobile number"
                   FontSize="24" Padding="8,6" Margin="0,12,0,0" />

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} prints it  ·  {1} back">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!-- Void a settled sale. -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsVoiding, Converter={StaticResource BoolToVisibility}}">
      <Border Width="620" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}" BorderBrush="{DynamicResource Danger}" BorderThickness="2">
        <StackPanel>
          <TextBlock Text="Void a sale" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Danger}" />
          <TextBlock Foreground="{DynamicResource InkMuted}" FontSize="13" Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     Text="Leave blank for the last bill, or type the invoice number. The bill stays in the books marked cancelled, its number stays used, and any loyalty points go back." />
          <TextBox x:Name="VoidBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Bill to void: invoice number"
                   FontSize="24" Padding="8,6" Margin="0,12,0,0" />

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} shows the bill, {0} again voids it  ·  {1} back, nothing voided">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!-- Who is on the till. -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsSettingCashier, Converter={StaticResource BoolToVisibility}}">
      <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <TextBlock Text="Cashier" FontSize="22" FontWeight="Bold" />
          <TextBlock Foreground="{DynamicResource InkMuted}" FontSize="13" Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     Text="Every sale from here on is recorded against this name, so the day-end report can attribute takings." />

          <!-- A lane with no cashiers set up: the name, typed. -->
          <StackPanel Visibility="{Binding TypesCashierName, Converter={StaticResource BoolToVisibility}}">
            <TextBox x:Name="CashierBox"
                     Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Cashier's name"
                     FontSize="24" Padding="8,6" Margin="0,12,0,0" />

            <TextBlock Style="{StaticResource PaneKeys}">
              <TextBlock.Text>
                <MultiBinding StringFormat="{}{0} saves the name  ·  {1} back">
                  <Binding Path="CommitKey" />
                  <Binding Path="CancelKey" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>

          <!-- A lane with cashiers set up: your name from the list, and your own PIN. -->
          <StackPanel Visibility="{Binding UsesCashierPins, Converter={StaticResource BoolToVisibility}}">
            <ListBox x:Name="CashierList" ItemsSource="{Binding CashierChoices}" SelectedIndex="{Binding SelectedCashierIndex, Mode=OneWay}"
                     AutomationProperties.Name="Cashiers" Focusable="False" MaxHeight="220" Margin="0,12,0,0"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontSize="18" Padding="6,4" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="PIN" Foreground="{DynamicResource InkMuted}" FontSize="13" Margin="0,12,0,4" />
            <PasswordBox x:Name="CashierPinBox" AutomationProperties.Name="Your PIN"
                         FontSize="24" Padding="8,6" PasswordChanged="CashierPin_Changed" />

            <TextBlock Style="{StaticResource PaneKeys}">
              <TextBlock.Text>
                <MultiBinding StringFormat="↑ ↓ your name  ·  type your PIN  ·  {0} signs you on  ·  {1} back">
                  <Binding Path="CommitKey" />
                  <Binding Path="CancelKey" />
                </MultiBinding>
              </TextBlock.Text>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!-- Taking a payment against what a customer owes on the khata. The UPI code goes beside the
         tenders rather than under them: stacked, the card was taller than the space above the
         message bar on a 768-high till, and its keys were behind the bar. -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsCollecting, Converter={StaticResource BoolToVisibility}}">
      <Border x:Name="CollectPane" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="506" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
              <TextBlock Text="Khata payment" FontSize="22" FontWeight="Bold" />
              <TextBlock Text="{Binding CollectPrompt, Mode=OneWay}" Foreground="{DynamicResource InkMuted}"
                         FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
              <TextBox x:Name="CollectBox"
                       Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="{Binding CollectPrompt, Mode=OneWay}"
                       FontSize="24" Padding="8,6" Margin="0,6,0,0" />

              <!-- Finding them: the same matches as F7, picked the same way. -->
              <ListBox AutomationProperties.Name="Customers matching" ItemsSource="{Binding CustomerMatches}"
                       SelectedIndex="{Binding SelectedCustomerMatchIndex, Mode=OneWay}"
                       Visibility="{Binding HasCustomerMatches, Converter={StaticResource BoolToVisibility}}"
                       Focusable="False" Margin="0,10,0,0" MaxHeight="230"
                       ItemContainerStyle="{StaticResource TintedListItem}"
                       Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource CardEdge}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" FontSize="15" TextTrimming="CharacterEllipsis"
                                 Text="{Binding Name, TargetNullValue='(no name)'}" />
                      <TextBlock Grid.Column="1" FontSize="15" Margin="12,0,0,0"
                                 FontFamily="{StaticResource FigureFont}" Text="{Binding MobileNo}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <!-- Once found: how they are paying. Money only - never more credit, never points. -->
              <ListBox AutomationProperties.Name="Paid by" ItemsSource="{Binding CollectTenders}"
                       SelectedIndex="{Binding SelectedCollectTenderIndex, Mode=OneWay}"
                       Visibility="{Binding IsCollectingAmount, Converter={StaticResource BoolToVisibility}}"
                       Focusable="False" Margin="0,10,0,0"
                       ItemContainerStyle="{StaticResource TintedListItem}"
                       Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource CardEdge}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="15" Text="{Binding Converter={StaticResource TenderLabel}}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}"
                         Visibility="{Binding IsCollectingAmount, Converter={StaticResource BoolToVisibility}}"
                         Text="Ctrl+K prints their khata statement. Ctrl+Q prints the UPI code." />
            </StackPanel>

            <!-- Paying back by UPI: the code for what they owe, or what they are paying. The side is
                 kept, at the code's size, for as long as the amount is being taken - with a word on
                 UPI in it when there is no code - so the card is one size whichever way they pay. -->
            <Border x:Name="CollectUpiPanel" Grid.Column="1" Width="360" MinHeight="184" Margin="20,0,0,0" Padding="12"
                    CornerRadius="10" VerticalAlignment="Center"
                    Visibility="{Binding IsCollectingAmount, Converter={StaticResource BoolToVisibility}}">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource FieldFill}" />
                  <Setter Property="BorderBrush" Value="{DynamicResource CardEdge}" />
                  <Setter Property="BorderThickness" Value="1" />
                  <Style.Triggers>
                    <!-- Black on white whatever the theme: a phone camera reads that best. -->
                    <DataTrigger Binding="{Binding ShowsUpiQr}" Value="True">
                      <Setter Property="Background" Value="White" />
                      <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <!-- Empty while the code shows. -->
                <TextBlock x:Name="CollectUpiNote" Text="{Binding CollectUpiNote, Mode=OneWay}" FontSize="13"
                           TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}" VerticalAlignment="Center" />

                <Grid Visibility="{Binding ShowsUpiQr, Converter={StaticResource BoolToVisibility}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <v:QrCodeView x:Name="CollectUpiCode" Text="{Binding UpiQr, Mode=OneWay}" Width="160" Height="160" />
                  <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Scan to pay with any UPI app" Foreground="#FF333333" FontSize="13" TextWrapping="Wrap" />
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" Height="36" Margin="0,4,0,2">
                      <TextBlock Text="{Binding UpiCaption, Mode=OneWay}" Foreground="Black" FontSize="28" FontWeight="Bold"
                                 FontFamily="{StaticResource FigureFont}" />
                    </Viewbox>
                    <TextBlock Text="{Binding UpiPayeeLine, Mode=OneWay}" Foreground="#FF333333" FontSize="12"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="↑ ↓ choose  ·  {0} takes the payment  ·  {1} back">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!-- Goods coming back: the bill, what is returned from it, and how the money goes back. -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsReturning, Converter={StaticResource BoolToVisibility}}">
      <Border Width="820" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <TextBlock Text="Return goods" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="{Binding ReturnBillLabel, Mode=OneWay}" FontSize="14" Margin="0,6,0,0"
                     FontFamily="{StaticResource FigureFont}"
                     Visibility="{Binding IsPickingReturn, Converter={StaticResource BoolToVisibility}}" />
          <TextBlock Text="{Binding ReturnPrompt, Mode=OneWay}" Foreground="{DynamicResource InkMuted}"
                     FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
          <TextBox x:Name="ReturnBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{Binding ReturnPrompt, Mode=OneWay}"
                   FontSize="24" Padding="8,6" Margin="0,6,0,0" />

          <!-- The bill's lines: sold, coming back now, and what that refunds. -->
          <!-- Rows take the pane's width, so a long name is trimmed rather than pushing the figures
               off to the side. -->
          <ListBox AutomationProperties.Name="Lines on the bill, to return from" x:Name="ReturnList"
                   ItemsSource="{Binding ReturnLines}"
                   SelectedIndex="{Binding SelectedReturnLineIndex, Mode=OneWay}"
                   Visibility="{Binding IsPickingReturn, Converter={StaticResource BoolToVisibility}}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   HorizontalContentAlignment="Stretch"
                   Focusable="False" Margin="0,10,0,0" MaxHeight="300"
                   ItemContainerStyle="{StaticResource TintedListItem}"
                   Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource CardEdge}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="90" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontSize="14" Foreground="{DynamicResource InkDim}" Text="{Binding LineNo}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock FontSize="15" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource InkMuted}" Text="{Binding Note}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" FontSize="14" Style="{StaticResource MutedNumericCell}">
                    <Run Text="sold" /> <Run Text="{Binding Sold, Mode=OneWay, StringFormat={}{0:0.###}}" /> <Run Text="{Binding Unit, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Grid.Column="3" FontSize="15" FontWeight="SemiBold" Style="{StaticResource NumericCell}"
                             Text="{Binding Returning, StringFormat={}{0:0.###}}" />
                  <TextBlock Grid.Column="4" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Negative}" Text="damaged">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Damaged}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <TextBlock Grid.Column="5" FontSize="15" Style="{StaticResource TotalCell}"
                             Text="{Binding Refund, StringFormat={}{0:N2}}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Text="{Binding ReturnSummary, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"
                     Visibility="{Binding IsPickingReturn, Converter={StaticResource BoolToVisibility}}" />

          <!-- How it goes back: money, or off the khata when the bill had a customer. -->
          <ListBox AutomationProperties.Name="How the refund goes back" ItemsSource="{Binding RefundOptions}"
                   SelectedIndex="{Binding SelectedRefundIndex, Mode=OneWay}"
                   Visibility="{Binding IsChoosingRefund, Converter={StaticResource BoolToVisibility}}"
                   Focusable="False" Margin="0,10,0,0"
                   ItemContainerStyle="{StaticResource TintedListItem}"
                   Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource CardEdge}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="15" Text="{Binding Label}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="↑ ↓ choose  ·  {0} next step  ·  {1} back, nothing returned">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!-- An order over the phone or on WhatsApp: pasted in, or saved from the bill on screen. -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsTakingOrder, Converter={StaticResource BoolToVisibility}}">
      <Border Width="720" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <TextBlock Text="Order" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="{Binding OrderPrompt, Mode=OneWay}" Foreground="{DynamicResource InkMuted}"
                     FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
          <!-- Several lines for a pasted message: Shift+Enter starts a new one, Enter reads them. -->
          <TextBox x:Name="OrderBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top" MinHeight="96" MaxHeight="260"
                   AutomationProperties.Name="{Binding OrderPrompt, Mode=OneWay}"
                   FontSize="18" Padding="8,6" Margin="0,6,0,0" />
          <ListBox AutomationProperties.Name="Phone or WhatsApp" ItemsSource="{Binding OrderKindLabels}"
                   SelectedIndex="{Binding SelectedOrderKindIndex, Mode=OneWay}"
                   Visibility="{Binding IsSavingOrder, Converter={StaticResource BoolToVisibility}}"
                   Focusable="False" Margin="0,10,0,0"
                   ItemContainerStyle="{StaticResource TintedListItem}"
                   Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource CardEdge}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="15" Text="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="Shift+Enter a new line  ·  {0} reads the order  ·  {1} back">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!-- A bill to a business: the customer's GSTIN, then their address. -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsSettingBusiness, Converter={StaticResource BoolToVisibility}}">
      <Border Width="640" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <TextBlock Text="Bill to a business" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="{Binding BusinessPrompt, Mode=OneWay}" Foreground="{DynamicResource InkMuted}"
                     FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
          <TextBox x:Name="BusinessBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{Binding BusinessPrompt, Mode=OneWay}"
                   TextWrapping="Wrap" MaxHeight="120" FontSize="22" Padding="8,6" Margin="0,6,0,0" />
          <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}"
                     Text="The GSTIN is checked as it is saved, and decides the state their bills are taxed in." />

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} next  ·  {1} back, nothing saved">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!-- Quick keys: the loose items, a key each, most often sold first. -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsUsingQuickKeys, Converter={StaticResource BoolToVisibility}}">
      <Border Width="900" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <TextBlock Text="Loose items" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="{Binding QuickKeyPrompt, Mode=OneWay}" Foreground="{DynamicResource InkMuted}"
                     FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
          <TextBox x:Name="QuickKeyBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{Binding QuickKeyPrompt, Mode=OneWay}"
                   FontSize="24" Padding="8,6" Margin="0,6,0,0" />

          <ListBox AutomationProperties.Name="Loose items" ItemsSource="{Binding QuickKeyTiles}"
                   SelectedIndex="{Binding SelectedQuickKeyIndex, Mode=OneWay}"
                   Focusable="False" Margin="0,12,0,0" MaxHeight="420"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ItemContainerStyle="{StaticResource TintedListItem}"
                   Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource CardEdge}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Width="200" Height="56" Margin="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="22" FontWeight="Bold"
                             Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Price}" FontSize="12" Foreground="{DynamicResource InkMuted}"
                               FontFamily="{StaticResource FigureFont}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="Type the item's key, then how many  ·  {0} puts it on the bill  ·  {1} back">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!-- Cash in and out of the drawer: the float, an expense, cash put in or taken out. -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsUsingDrawer, Converter={StaticResource BoolToVisibility}}">
      <Border Width="600" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <!-- A title per step: "Cash in and out" stayed up while it was asking what an expense was for. -->
          <TextBlock Text="{Binding DrawerTitle, Mode=OneWay}" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DrawerPrompt, Mode=OneWay}" Foreground="{DynamicResource InkMuted}"
                     FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
          <TextBox x:Name="DrawerBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{Binding DrawerPrompt, Mode=OneWay}"
                   FontSize="24" Padding="8,6" Margin="0,6,0,0" />

          <!-- What it is. -->
          <ListBox AutomationProperties.Name="What it is" ItemsSource="{Binding DrawerKindLabels}"
                   SelectedIndex="{Binding SelectedDrawerKindIndex, Mode=OneWay}"
                   Visibility="{Binding IsChoosingDrawerKind, Converter={StaticResource BoolToVisibility}}"
                   Focusable="False" Margin="0,10,0,0"
                   ItemContainerStyle="{StaticResource TintedListItem}"
                   Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource CardEdge}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="15" Text="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- For an expense: what it was for. -->
          <ListBox AutomationProperties.Name="What the expense was for" ItemsSource="{Binding ExpenseCategoryChoices}"
                   SelectedIndex="{Binding SelectedExpenseCategoryIndex, Mode=OneWay}"
                   Visibility="{Binding IsChoosingExpenseCategory, Converter={StaticResource BoolToVisibility}}"
                   Focusable="False" Margin="0,10,0,0" MaxHeight="300"
                   ItemContainerStyle="{StaticResource TintedListItem}"
                   Background="{DynamicResource FieldFill}" BorderBrush="{DynamicResource CardEdge}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="15" Text="{Binding}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="↑ ↓ choose  ·  {0} records it  ·  {1} back, nothing recorded">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!-- Recall list, over the whole screen while choosing a held bill (SRS 2.5). -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsRecalling, Converter={StaticResource BoolToVisibility}}">
      <Border Width="660" MaxHeight="480" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource PaneBadge}">
              <TextBlock Text="{x:Static app:Glyphs.Pause}" Style="{StaticResource Glyph}" FontSize="17" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="Held bills" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>

          <!--
            Sideways scrolling off, as in the return list: with it on, an order's note widened its row
            and pushed the amount off the edge behind a scrollbar - and the amount is what tells two
            of the same customer's bills apart. The note has a line of its own under the name instead.
          -->
          <ListBox AutomationProperties.Name="Held bills" Margin="0,14,0,0" MaxHeight="330"
                   Background="{DynamicResource FieldFill}"
                   BorderBrush="{DynamicResource CardEdge}"
                   Focusable="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   HorizontalContentAlignment="Stretch"
                   ItemContainerStyle="{StaticResource TintedListItem}"
                   ItemsSource="{Binding HeldBills}"
                   SelectedIndex="{Binding SelectedHeldBillIndex, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68" />
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="104" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Token}" FontWeight="Bold" FontFamily="{StaticResource FigureFont}" />
                  <TextBlock Grid.Column="1" Text="{Binding HeldAt, Converter={StaticResource Show}, ConverterParameter=dayTime}"
                             Foreground="{DynamicResource InkMuted}" />
                  <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="{Binding CustomerLabel}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                    <!-- An order says so, with where it is going or when, so it is not mistaken for a
                         bill somebody held to fetch their wallet. -->
                    <TextBlock Text="{Binding OrderLine}" FontSize="12" Foreground="{DynamicResource Accent}"
                               TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding IsOrder, Converter={StaticResource BoolToVisibility}}" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding ItemCount, Converter={StaticResource Plural}, ConverterParameter=item}"
                             HorizontalAlignment="Right" Foreground="{DynamicResource InkMuted}" />
                  <TextBlock Grid.Column="4" Text="{Binding GrandTotal, StringFormat={}{0:N2}}"
                             HorizontalAlignment="Right" FontFamily="{StaticResource FigureFont}" FontWeight="SemiBold" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="↑ ↓ choose  ·  {0} takes it back  ·  {1} closes">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!--
      Closing the day: the figures in a table, and both keys under them, before anything happens.
      It was one long status line that ended in the instruction - the part a narrow screen cut.
    -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsConfirmingDayClose, Converter={StaticResource BoolToVisibility}}">
      <Border x:Name="DayClosePane" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}" BorderBrush="{DynamicResource Warning}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource PaneBadge}" Background="{DynamicResource WarningSoft}">
              <TextBlock Text="{x:Static app:Glyphs.Lock}" Style="{StaticResource Glyph}" FontSize="17"
                         Foreground="{DynamicResource Warning}" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="Close the day?" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{Binding DayCloseNote}" Margin="0,12,0,0" FontSize="14" TextWrapping="Wrap"
                     Foreground="{DynamicResource InkMuted}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding DayCloseNote}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <ItemsControl ItemsSource="{Binding DayCloseRows}" Margin="0,14,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Row" Padding="0,7" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                  <Grid>
                    <TextBlock x:Name="Label" Text="{Binding Label}" Foreground="{DynamicResource InkMuted}" FontSize="15" />
                    <TextBlock x:Name="Value" Text="{Binding Value}" HorizontalAlignment="Right"
                               FontFamily="{StaticResource FigureFont}" FontSize="16" />
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Emphasis}" Value="True">
                    <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                    <Setter TargetName="Row" Property="Padding" Value="0,12,0,0" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Ink}" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Label" Property="VerticalAlignment" Value="Center" />
                    <Setter TargetName="Value" Property="FontSize" Value="24" />
                    <Setter TargetName="Value" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Positive}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- The count, typed before the till says what it expects. -->
          <StackPanel Margin="0,14,0,0">
            <TextBlock Text="Cash counted in the drawer" Foreground="{DynamicResource InkMuted}" FontSize="13" Margin="0,0,0,4" />
            <TextBox x:Name="CloseCountBox"
                     Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Cash counted in the drawer"
                     FontFamily="{StaticResource FigureFont}" FontSize="22" Padding="8,4" />
          </StackPanel>

          <TextBlock Style="{StaticResource PaneKeys}" Text="{Binding DayCloseKeys}" />
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!--
      F1: every key on this lane and what it does, read off the keymap - the ones on the strip and
      the six that have no room there.
    -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsShowingKeys, Converter={StaticResource BoolToVisibility}}">
      <Border x:Name="KeySheetPane" Width="980" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource PaneBadge}">
              <TextBlock Text="{x:Static app:Glyphs.Keyboard}" Style="{StaticResource Glyph}" FontSize="17" HorizontalAlignment="Center" />
            </Border>
            <TextBlock Text="Keys" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>

          <ItemsControl x:Name="KeySheet" Margin="0,14,0,0" Focusable="False"
                        AutomationProperties.Name="Every key on this lane">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2,18,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border HorizontalAlignment="Left" Background="{DynamicResource KeyCapFill}" BorderBrush="{DynamicResource KeyCapEdge}" BorderThickness="1,1,1,2"
                          CornerRadius="4" Padding="6,0">
                    <TextBlock Text="{Binding Keys}" Foreground="{DynamicResource Accent}" FontFamily="{StaticResource FigureFont}"
                               FontSize="12" FontWeight="Bold" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="13.5" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock x:Name="KeySheetFooter" Style="{StaticResource PaneKeys}" />
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!--
      An item on the shelf but not in the catalogue: what it is, its price, its GST slab. One box for
      the name and the price in turn, then the slabs as a list with nothing picked until the cashier
      picks it.
    -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsAddingOpenItem, Converter={StaticResource BoolToVisibility}}">
      <Border x:Name="OpenItemPane" Width="680" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <TextBlock Text="An item not in the catalogue" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="{Binding OpenItemSoFar, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"
                     Margin="0,8,0,0" TextWrapping="Wrap" />
          <TextBlock Text="{Binding OpenItemPrompt, Mode=OneWay}" Foreground="{DynamicResource InkMuted}"
                     FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" />
          <TextBox x:Name="OpenItemBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="{Binding OpenItemPrompt, Mode=OneWay}"
                   Visibility="{Binding IsTypingOpenItem, Converter={StaticResource BoolToVisibility}}"
                   FontSize="22" Padding="8,6" Margin="0,6,0,0" />
          <ListBox x:Name="OpenRateList" ItemsSource="{Binding OpenItemRates}" SelectedIndex="{Binding SelectedOpenRateIndex}"
                   AutomationProperties.Name="GST slabs for the item"
                   Visibility="{Binding IsChoosingOpenRate, Converter={StaticResource BoolToVisibility}}"
                   Margin="0,8,0,0" MaxHeight="300" Background="Transparent" BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" FontSize="15" Padding="6,5" TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}"
                     Text="It is sold as typed and nothing comes off any shelf count. The owner sees it on the Catalogue tab, to add it properly." />

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="↑ ↓ the slab  ·  {0} next  ·  {1} a step back">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!--
      One barcode, two MRPs on the shelf: which one is printed on the pack in hand. Only the cashier
      can tell, so the till asks rather than charge a pack more than it says.
    -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsChoosingMrp, Converter={StaticResource BoolToVisibility}}">
      <Border x:Name="MrpPane" Width="620" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}">
        <StackPanel>
          <TextBlock Text="Which MRP is on the pack?" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="{Binding MrpQuestion}" Foreground="{DynamicResource InkMuted}" FontSize="13"
                     Margin="0,8,0,0" TextWrapping="Wrap" />
          <ListBox x:Name="MrpList" ItemsSource="{Binding MrpChoices}" SelectedIndex="{Binding SelectedMrpIndex}"
                   AutomationProperties.Name="The MRPs on the shelf" Margin="0,12,0,0"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" FontSize="17" Padding="6,6" TextWrapping="Wrap" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="↑ ↓ the MRP on the pack  ·  {0} puts it on the bill  ·  {1} back, nothing added">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>

    <!--
      The owner's PIN, over whatever asked for it - last in the file so it is drawn on top of every
      other pane. The thing being approved is named with its amount, so the owner approves that
      and not merely a screen.
    -->
    <v:PaneScrim Grid.Row="0" Grid.RowSpan="6"
            Visibility="{Binding IsApproving, Converter={StaticResource BoolToVisibility}}">
      <Border x:Name="ApprovalPane" Width="560" VerticalAlignment="Center" HorizontalAlignment="Center"
              Style="{StaticResource PaneCard}" BorderBrush="{DynamicResource Warning}" BorderThickness="2">
        <StackPanel>
          <TextBlock Text="The owner's PIN" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Warning}" />
          <TextBlock Text="{Binding ApprovalWhat, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                     TextWrapping="Wrap" Margin="0,10,0,0" />
          <TextBlock Foreground="{DynamicResource InkMuted}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="This lane asks the owner before this is done. Whether it was approved is recorded, with who was on the till." />
          <PasswordBox x:Name="ApprovalBox" AutomationProperties.Name="The owner's PIN"
                       FontSize="24" Padding="8,6" Margin="0,14,0,0" PasswordChanged="ApprovalPin_Changed" />

          <TextBlock Style="{StaticResource PaneKeys}">
            <TextBlock.Text>
              <MultiBinding StringFormat="{}{0} approves  ·  {1} back, nothing done">
                <Binding Path="CommitKey" />
                <Binding Path="CancelKey" />
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
      </Border>
    </v:PaneScrim>
  </Grid>
</Window>
