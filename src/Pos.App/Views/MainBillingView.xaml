<Window x:Class="Pos.App.Views.MainBillingView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Pos.App.ViewModels"
        Title="RetailPOS — Billing"
        WindowState="Maximized"
        Background="{StaticResource Surface}"
        FontFamily="Segoe UI">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <vm:TenderTypeLabelConverter x:Key="TenderLabel" />

    <!-- Money and quantities line up on the decimal point, so a column of figures scans down. -->
    <Style x:Key="NumericCell" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search: one box for both typed queries and scanner bursts (SRS 2.1). -->
    <Border Grid.Row="0" Background="{StaticResource SurfaceRaised}" CornerRadius="6" Padding="12">
      <StackPanel>
        <TextBlock Text="Scan or search" Foreground="{StaticResource InkMuted}" FontSize="12" />
        <TextBox x:Name="SearchBox"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="24"
                 Padding="8,6"
                 Margin="0,4,0,0"
                 Background="{StaticResource Surface}"
                 Foreground="{StaticResource Ink}"
                 CaretBrush="{StaticResource Accent}"
                 BorderBrush="{StaticResource Line}"
                 BorderThickness="1" />

        <!-- Result list, shown only when a query matched more than one item. -->
        <ListBox x:Name="ResultList"
                 Margin="0,8,0,0"
                 MaxHeight="180"
                 Background="{StaticResource Surface}"
                 BorderBrush="{StaticResource Line}"
                 Focusable="False"
                 ItemsSource="{Binding SearchResults}"
                 SelectedIndex="{Binding SelectedResultIndex, Mode=TwoWay}"
                 Visibility="{Binding IsResultListOpen, Converter={StaticResource BoolToVisibility}}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="4,2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Text="{Binding Sku}" Foreground="{StaticResource InkMuted}" />
                <TextBlock Grid.Column="2" Text="{Binding SellPrice, StringFormat={}{0:N2}}"
                           HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>

    <!-- Line grid and totals. -->
    <Grid Grid.Row="1" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <DataGrid x:Name="LineGrid"
                Grid.Column="0"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                HeadersVisibility="Column"
                GridLinesVisibility="Horizontal"
                Background="{StaticResource SurfaceRaised}"
                RowBackground="{StaticResource SurfaceRaised}"
                Foreground="{StaticResource Ink}"
                BorderBrush="{StaticResource Line}"
                HorizontalGridLinesBrush="{StaticResource Line}"
                FontSize="15"
                RowHeight="30"
                ItemsSource="{Binding Lines}"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                SelectedIndex="{Binding SelectedLineIndex, Mode=TwoWay}">
        <!--
          Every column is Auto, so the grid measures its own headers and cells rather than
          trusting a width somebody guessed.

          This is not a style preference. Hand-picked widths were clipping figures: a quantity of
          1.25 rendered as ".25" because the cell was a few pixels short and the text is
          right-aligned, so it overflowed and was cut on the left. A price that reads wrong on a
          till is worse than a column that shifts by a few pixels when the widest value changes,
          and no amount of picking better numbers makes the whole class of fault go away.

          The item name is Auto too, bounded rather than starred. A * column claims the leftover
          width before the Auto columns have finished measuring, so when the row content turned
          out wider than the headers the name kept its over-generous share and the grid took the
          difference out of the last two columns instead — Tax and Total were squeezed to slivers.
          Bounding the name means the widths always sum to what the columns actually need, and if
          that exceeds the screen the grid scrolls sideways rather than crushing anything.
        -->
        <DataGrid.Columns>
          <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="Auto" MinWidth="200" MaxWidth="380" />
          <DataGridTextColumn Header="HSN" Binding="{Binding Hsn}" Width="Auto" />
          <DataGridTextColumn Header="Barcode / Batch" Binding="{Binding BarcodeOrBatch}" Width="Auto" />
          <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="Auto"
                              ElementStyle="{StaticResource NumericCell}" />
          <DataGridTextColumn Header="Unit" Binding="{Binding UnitLabel}" Width="Auto" />
          <DataGridTextColumn Header="MRP" Binding="{Binding Mrp, StringFormat={}{0:N2}}" Width="Auto"
                              ElementStyle="{StaticResource NumericCell}" />
          <DataGridTextColumn Header="Rate" Binding="{Binding UnitRateExclTax, StringFormat={}{0:N2}}" Width="Auto"
                              ElementStyle="{StaticResource NumericCell}" />
          <DataGridTextColumn Header="Disc" Binding="{Binding Discount, StringFormat={}{0:N2}}" Width="Auto"
                              ElementStyle="{StaticResource NumericCell}" />
          <DataGridTextColumn Header="CGST %" Binding="{Binding CgstRate, StringFormat={}{0:0.##}}" Width="Auto"
                              ElementStyle="{StaticResource NumericCell}" />
          <DataGridTextColumn Header="SGST %" Binding="{Binding SgstRate, StringFormat={}{0:0.##}}" Width="Auto"
                              ElementStyle="{StaticResource NumericCell}" />
          <DataGridTextColumn Header="IGST %" Binding="{Binding IgstRate, StringFormat={}{0:0.##}}" Width="Auto"
                              ElementStyle="{StaticResource NumericCell}" />
          <DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat={}{0:N2}}" Width="Auto"
                              ElementStyle="{StaticResource NumericCell}" />
          <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="Auto"
                              ElementStyle="{StaticResource NumericCell}" />
        </DataGrid.Columns>
      </DataGrid>

      <Border Grid.Column="1" Margin="12,0,0,0" Padding="16"
              Background="{StaticResource SurfaceRaised}" CornerRadius="6">
        <!--
          Docked, not stacked. This panel sits beside a grid that gets shorter whenever the search
          results open under the scan box, and as one tall StackPanel it overran the bottom edge in
          that state — the cashier's name was cut in half. Docking the figures to the top and the
          customer and cashier to the bottom means both blocks always get their space and the
          slack falls in the middle, where there is nothing to lose.
        -->
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Taxable" Foreground="{StaticResource InkMuted}" FontSize="12" />
            <TextBlock Text="{Binding Totals.SubtotalTaxable, StringFormat={}{0:N2}}" FontSize="18" />

            <TextBlock Text="Discount" Foreground="{StaticResource InkMuted}" FontSize="12" Margin="0,10,0,0" />
            <TextBlock Text="{Binding Totals.TotalDiscount, StringFormat={}{0:N2}}" FontSize="18" />

            <TextBlock Text="CGST / SGST / IGST" Foreground="{StaticResource InkMuted}" FontSize="12" Margin="0,10,0,0" />
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Totals.TotalCgst, StringFormat={}{0:N2}}" FontSize="18" />
              <TextBlock Text=" / " FontSize="18" Foreground="{StaticResource InkMuted}" />
              <TextBlock Text="{Binding Totals.TotalSgst, StringFormat={}{0:N2}}" FontSize="18" />
              <TextBlock Text=" / " FontSize="18" Foreground="{StaticResource InkMuted}" />
              <TextBlock Text="{Binding Totals.TotalIgst, StringFormat={}{0:N2}}" FontSize="18" />
            </StackPanel>

            <Separator Margin="0,16" Background="{StaticResource Line}" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom">
            <Separator Margin="0,16" Background="{StaticResource Line}" />

            <TextBlock Text="Customer" Foreground="{StaticResource InkMuted}" FontSize="12" />
            <TextBlock Text="{Binding CustomerLabel}" FontSize="18" />
            <TextBlock Foreground="{StaticResource Accent}" FontSize="13"
                       Visibility="{Binding HasCustomer, Converter={StaticResource BoolToVisibility}}"
                       Text="{Binding LoyaltyBalance, StringFormat={}{0} points}" />

            <TextBlock Text="Cashier" Foreground="{StaticResource InkMuted}" FontSize="12" Margin="0,10,0,0" />
            <TextBlock Text="{Binding CashierLabel}" FontSize="15" />
          </StackPanel>

          <!-- NFR-02: the grand total is the one figure that must read across the counter. -->
          <StackPanel VerticalAlignment="Top">
            <TextBlock Text="TOTAL" Foreground="{StaticResource InkMuted}" FontSize="14" />
            <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N2}}"
                       Foreground="{StaticResource Positive}"
                       FontSize="68"
                       FontWeight="Bold"
                       TextAlignment="Right"
                       LineHeight="74"
                       LineStackingStrategy="BlockLineHeight" />

            <TextBlock Text="{Binding Totals.LineCount, StringFormat={}{0} lines}"
                       Foreground="{StaticResource InkMuted}"
                       FontSize="13"
                       TextAlignment="Right" />
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- In-place editor for the two editable cells. -->
    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12"
            Background="{StaticResource SurfaceRaised}" CornerRadius="6"
            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding EditingColumn}" FontSize="18" VerticalAlignment="Center"
                   Foreground="{StaticResource Accent}" />
        <TextBox x:Name="EditBox"
                 Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                 Width="180" FontSize="20" Margin="12,0,0,0" Padding="6,4"
                 Background="{StaticResource Surface}"
                 Foreground="{StaticResource Ink}"
                 CaretBrush="{StaticResource Accent}"
                 BorderBrush="{StaticResource Line}" />
      </StackPanel>
    </Border>

    <!-- Status line. -->
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{StaticResource Accent}" />
      <TextBlock x:Name="KeyHints" Grid.Column="1" Foreground="{StaticResource InkMuted}" FontSize="12" />
    </Grid>

    <!-- Tender pane, over the whole screen while taking payment (SRS 2.4). -->
    <Border Grid.Row="0" Grid.RowSpan="4"
            Background="#E6101418"
            Visibility="{Binding IsTendering, Converter={StaticResource BoolToVisibility}}">
      <Border Width="760" VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="24"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <Grid>
            <TextBlock Text="Payment" FontSize="22" FontWeight="Bold" />
            <TextBlock HorizontalAlignment="Right" FontSize="22"
                       Text="{Binding AmountDue, StringFormat=Due {0:N2}}" />
          </Grid>

          <!-- Tender types. Arrows move; typing an amount and committing takes the payment. -->
          <ListBox Margin="0,16,0,0"
                   Background="{StaticResource Surface}"
                   BorderBrush="{StaticResource Line}"
                   Focusable="False"
                   ItemsSource="{Binding TenderTypes}"
                   SelectedIndex="{Binding SelectedTenderTypeIndex, Mode=TwoWay}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Converter={StaticResource TenderLabel}}"
                           Margin="8,10" HorizontalAlignment="Center" FontSize="15" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="{Binding SelectedTenderType, Converter={StaticResource TenderLabel}}"
                       FontSize="18" VerticalAlignment="Center"
                       Foreground="{StaticResource Accent}" Width="150" TextWrapping="Wrap" />
            <TextBox x:Name="TenderBox"
                     Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                     Width="220" FontSize="24" Padding="8,6"
                     Background="{StaticResource Surface}"
                     Foreground="{StaticResource Ink}"
                     CaretBrush="{StaticResource Accent}"
                     BorderBrush="{StaticResource Line}" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13" Width="290"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource InkMuted}"
                       Text="Leave blank to take the whole balance. Loyalty is entered in points, not rupees." />
          </StackPanel>

          <!-- Payments taken so far. -->
          <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Payments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Type, Converter={StaticResource TenderLabel}}" />
                  <TextBlock Grid.Column="1" Text="{Binding ReferenceNo}" Foreground="{StaticResource InkMuted}" />
                  <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:N2}}"
                             HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Separator Margin="0,16" Background="{StaticResource Line}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Still due" Foreground="{StaticResource InkMuted}" FontSize="12" />
              <TextBlock Text="{Binding AmountRemaining, StringFormat={}{0:N2}}" FontSize="34" FontWeight="Bold" />
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Change" Foreground="{StaticResource InkMuted}" FontSize="12" TextAlignment="Right" />
              <TextBlock Text="{Binding ChangeDue, StringFormat={}{0:N2}}" FontSize="34" FontWeight="Bold"
                         TextAlignment="Right" Foreground="{StaticResource Positive}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- Customer lookup by mobile number. -->
    <Border Grid.Row="0" Grid.RowSpan="4"
            Background="#E6101418"
            Visibility="{Binding IsFindingCustomer, Converter={StaticResource BoolToVisibility}}">
      <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="24"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Customer" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Mobile number" Foreground="{StaticResource InkMuted}" FontSize="12" Margin="0,12,0,0" />
          <TextBox x:Name="CustomerBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="24" Padding="8,6" Margin="0,4,0,0"
                   Background="{StaticResource Surface}"
                   Foreground="{StaticResource Ink}"
                   CaretBrush="{StaticResource Accent}"
                   BorderBrush="{StaticResource Line}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Reprint a past invoice. -->
    <Border Grid.Row="0" Grid.RowSpan="4"
            Background="#E6101418"
            Visibility="{Binding IsReprinting, Converter={StaticResource BoolToVisibility}}">
      <Border Width="600" VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="24"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Reprint a bill" FontSize="22" FontWeight="Bold" />
          <TextBlock Foreground="{StaticResource InkMuted}" FontSize="13" Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     Text="Leave blank for the last bill on this lane, or type an invoice number or the customer's mobile number." />
          <TextBox x:Name="ReprintBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="24" Padding="8,6" Margin="0,12,0,0"
                   Background="{StaticResource Surface}"
                   Foreground="{StaticResource Ink}"
                   CaretBrush="{StaticResource Accent}"
                   BorderBrush="{StaticResource Line}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Void a settled sale. -->
    <Border Grid.Row="0" Grid.RowSpan="4"
            Background="#E6101418"
            Visibility="{Binding IsVoiding, Converter={StaticResource BoolToVisibility}}">
      <Border Width="620" VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="24"
              BorderBrush="#FFB4472F" BorderThickness="2">
        <StackPanel>
          <TextBlock Text="Void a sale" FontSize="22" FontWeight="Bold" Foreground="#FFE0765C" />
          <TextBlock Foreground="{StaticResource InkMuted}" FontSize="13" Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     Text="Leave blank for the last bill, or type the invoice number. The bill stays in the books marked cancelled, its number stays used, and any loyalty points go back." />
          <TextBox x:Name="VoidBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="24" Padding="8,6" Margin="0,12,0,0"
                   Background="{StaticResource Surface}"
                   Foreground="{StaticResource Ink}"
                   CaretBrush="{StaticResource Accent}"
                   BorderBrush="{StaticResource Line}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Who is on the till. -->
    <Border Grid.Row="0" Grid.RowSpan="4"
            Background="#E6101418"
            Visibility="{Binding IsSettingCashier, Converter={StaticResource BoolToVisibility}}">
      <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="24"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Cashier" FontSize="22" FontWeight="Bold" />
          <TextBlock Foreground="{StaticResource InkMuted}" FontSize="13" Margin="0,8,0,0"
                     TextWrapping="Wrap"
                     Text="Every sale from here on is recorded against this name, so the day-end report can attribute takings." />
          <TextBox x:Name="CashierBox"
                   Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="24" Padding="8,6" Margin="0,12,0,0"
                   Background="{StaticResource Surface}"
                   Foreground="{StaticResource Ink}"
                   CaretBrush="{StaticResource Accent}"
                   BorderBrush="{StaticResource Line}" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Recall list, over the whole screen while choosing a parked bill (SRS 2.5). -->
    <Border Grid.Row="0" Grid.RowSpan="4"
            Background="#E6101418"
            Visibility="{Binding IsRecalling, Converter={StaticResource BoolToVisibility}}">
      <Border Width="640" MaxHeight="440" VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{StaticResource SurfaceRaised}" CornerRadius="8" Padding="20"
              BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Parked bills" FontSize="22" FontWeight="Bold" />
          <ListBox Margin="0,12,0,0" MaxHeight="320"
                   Background="{StaticResource Surface}"
                   BorderBrush="{StaticResource Line}"
                   Focusable="False"
                   ItemsSource="{Binding HeldBills}"
                   SelectedIndex="{Binding SelectedHeldBillIndex, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="4,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="110" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Token}" FontWeight="Bold" />
                  <TextBlock Grid.Column="1" Text="{Binding HeldAt, StringFormat={}{0:dd MMM HH:mm}}"
                             Foreground="{StaticResource InkMuted}" />
                  <TextBlock Grid.Column="2" Text="{Binding CustomerLabel}" />
                  <TextBlock Grid.Column="3" Text="{Binding ItemCount, StringFormat={}{0} items}"
                             HorizontalAlignment="Right" Foreground="{StaticResource InkMuted}" />
                  <TextBlock Grid.Column="4" Text="{Binding GrandTotal, StringFormat={}{0:N2}}"
                             HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
