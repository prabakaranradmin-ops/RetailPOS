<Window x:Class="Pos.App.Views.OwnerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Pos.App.Views"
        Title="RetailPOS — Owner" Height="900" Width="1440"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Background="{StaticResource Surface}">

  <Window.Resources>
    <SolidColorBrush x:Key="Warn" Color="#FFFF7A66" />

    <v:StarShareConverter x:Key="Share" />
    <v:StarShareConverter x:Key="Rest" Remainder="True" />

    <!--
      The stock tab chrome paints itself in system light colours, which on this background gives a
      pale tab with pale text on it — the header was unreadable, selected or not. Templated rather
      than tinted because the default template layers a border and a highlight of its own that no
      amount of property setting reaches.
    -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="Chrome" Background="Transparent" Padding="18,10" Margin="0,0,4,0"
                    BorderBrush="Transparent" BorderThickness="0,0,0,2">
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceRaised}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      Buttons and text boxes are styled here rather than in App.xaml. They keep their system chrome
      everywhere else, and on this dark background that chrome puts a white label on a white face —
      the Apply button read as an empty rectangle. Scoped to this window so the billing screen,
      which the shop already knows, is not touched by any of it.
    -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="6" Background="#FF243040"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#FF2E3D50" />
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.4" />
                <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF0B0F13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#FF0B0F13" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,16" />
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="Figure" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <!-- A ranked row: name, detail, amount, and a bar as wide as its share of the biggest. -->
    <DataTemplate x:Key="RankedRowTemplate">
      <Grid Margin="0,0,0,11">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,16,0">
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Label}" Margin="0,1,0,4" />
          <Grid Height="6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource Share}}" />
              <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource Rest}}" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="3" Background="{StaticResource Accent}" Opacity="0.85" />
            <Border Grid.Column="1" CornerRadius="3" Background="{StaticResource Line}" Margin="2,0,0,0" />
          </Grid>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="16" VerticalAlignment="Top" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header ================================================================================ -->
    <Grid Grid.Row="0" Margin="24,20,24,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Text="Owner" FontSize="26" />
        <TextBlock Style="{StaticResource Label}" Margin="0,2,0,0">
          <Run Text="Lane" /><Run Text=" " /><Run Text="{Binding LaneId, Mode=OneWay}" />
          <Run Text=" · " /><Run Text="{Binding ReadIn, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Period" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,10,0" />
        <RadioButton x:Name="Days7" Content="7 days" GroupName="Days" Margin="0,0,12,0"
                     Foreground="{StaticResource Ink}" VerticalAlignment="Center" Checked="Days_Checked" Tag="7" />
        <RadioButton x:Name="Days30" Content="30 days" GroupName="Days" Margin="0,0,12,0" IsChecked="True"
                     Foreground="{StaticResource Ink}" VerticalAlignment="Center" Checked="Days_Checked" Tag="30" />
        <RadioButton x:Name="Days90" Content="90 days" GroupName="Days" Margin="0,0,20,0"
                     Foreground="{StaticResource Ink}" VerticalAlignment="Center" Checked="Days_Checked" Tag="90" />
        <Button Content="Refresh" Padding="14,6" Click="Refresh_Click" />
      </StackPanel>
    </Grid>

    <!-- Body ================================================================================== -->
    <TabControl x:Name="Tabs" Grid.Row="1" Margin="16,0,16,0" Background="Transparent" BorderThickness="0">

      <!-- ==== The figures ==== -->
      <TabItem Header="The figures  (Ctrl+1)">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,12,8,8">
          <StackPanel>

            <UniformGrid Rows="1" Margin="0,0,0,16">
              <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="NET SALES, THE PERIOD" Style="{StaticResource Heading}" Margin="0" />
                  <TextBlock Text="{Binding PeriodNetSales, Mode=OneWay}" Style="{StaticResource Figure}"
                             Foreground="{StaticResource Positive}" />
                  <TextBlock Style="{StaticResource Label}" Margin="0,4,0,0">
                    <Run Text="{Binding PeriodBills, Mode=OneWay}" /><Run Text=" bills · " />
                    <Run Text="{Binding PeriodDiscount, Mode=OneWay}" /><Run Text=" given away" />
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="TODAY" Style="{StaticResource Heading}" Margin="0" />
                  <TextBlock Text="{Binding TodayNetSales, Mode=OneWay}" Style="{StaticResource Figure}" />
                  <TextBlock Style="{StaticResource Label}" Margin="0,4,0,0">
                    <Run Text="{Binding TodayBills, Mode=OneWay}" /><Run Text=" bills since midnight" />
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel>
                  <TextBlock Text="CASH TAKEN" Style="{StaticResource Heading}" Margin="0" />
                  <TextBlock Text="{Binding PeriodCash, Mode=OneWay}" Style="{StaticResource Figure}" />
                  <TextBlock Text="what the drawer should hold, less your float"
                             Style="{StaticResource Label}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="CARD, UPI AND CREDIT" Style="{StaticResource Heading}" Margin="0" />
                  <TextBlock Text="{Binding PeriodDigital, Mode=OneWay}" Style="{StaticResource Figure}" />
                  <TextBlock Text="what should reach the bank"
                             Style="{StaticResource Label}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="WHEN THE SHOP IS BUSY" Style="{StaticResource Heading}" />
                <ItemsControl ItemsSource="{Binding Hourly}" Height="150">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="2,0" ToolTip="{Binding Tooltip}">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="*" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="{Binding Fraction, Converter={StaticResource Rest}}" />
                            <RowDefinition Height="{Binding Fraction, Converter={StaticResource Share}}" />
                          </Grid.RowDefinitions>
                          <Border Grid.Row="1" CornerRadius="3,3,0,0" MinHeight="2"
                                  Background="{StaticResource Accent}" Opacity="0.85" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{Binding Label}" Style="{StaticResource Label}"
                                   HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="10" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="The quiet hours are as useful as the busy ones — they are when a delivery or a stock count fits."
                           Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="WHAT SELLS — BY WHAT IT BRINGS IN" Style="{StaticResource Heading}" />
                  <ItemsControl ItemsSource="{Binding TopItems}" ItemTemplate="{StaticResource RankedRowTemplate}" />
                </StackPanel>
              </Border>

              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="HOW CUSTOMERS PAID" Style="{StaticResource Heading}" />
                    <ItemsControl ItemsSource="{Binding Tenders}" ItemTemplate="{StaticResource RankedRowTemplate}" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="WHERE THE TAKINGS CAME FROM" Style="{StaticResource Heading}" />
                    <ItemsControl ItemsSource="{Binding Categories}" ItemTemplate="{StaticResource RankedRowTemplate}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>

            <!-- Absent entirely on a composition lane: a table of zeroes would read as a shop
                 that applied a nil rate, rather than one not permitted to charge at all. -->
            <Border x:Name="GstCard" Style="{StaticResource Card}" Margin="0,0,0,20">
              <StackPanel>
                <TextBlock Text="GST BY SLAB — WHAT A RETURN IS FILED FROM" Style="{StaticResource Heading}" />
                <DataGrid ItemsSource="{Binding GstSlabs}" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}"
                          HeadersVisibility="Column" Foreground="{StaticResource Ink}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Slab" Binding="{Binding Rate, StringFormat={}{0:0.##}%}" Width="90" />
                    <DataGridTextColumn Header="Taxable" Binding="{Binding TaxableValue, StringFormat={}{0:N2}}" Width="*" />
                    <DataGridTextColumn Header="CGST" Binding="{Binding Cgst, StringFormat={}{0:N2}}" Width="*" />
                    <DataGridTextColumn Header="SGST" Binding="{Binding Sgst, StringFormat={}{0:N2}}" Width="*" />
                    <DataGridTextColumn Header="IGST" Binding="{Binding Igst, StringFormat={}{0:N2}}" Width="*" />
                    <DataGridTextColumn Header="Tax" Binding="{Binding TotalTax, StringFormat={}{0:N2}}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>

            <Border x:Name="NoGstCard" Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="GST" Style="{StaticResource Heading}" />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource InkMuted}"
                           Text="This lane issues a bill of supply, so it charges no GST and there is nothing to break down. Change that under Settings." />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ==== Stock ==== -->
      <TabItem Header="Stock  (Ctrl+2)">
        <Grid Margin="8,12,8,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StockHeadline, Mode=OneWay}" FontSize="15"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <RadioButton Content="Needs reordering" GroupName="StockFilter" IsChecked="{Binding LowOnly}"
                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" Margin="0,0,14,0" />
              <RadioButton Content="Everything counted" GroupName="StockFilter"
                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>

          <DataGrid Grid.Row="1" ItemsSource="{Binding Stock}" SelectedItem="{Binding SelectedStock}"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                    Background="Transparent" RowBackground="Transparent" BorderThickness="0"
                    GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Line}"
                    HeadersVisibility="Column" Foreground="{StaticResource Ink}"
                    SelectionMode="Single" RowHeight="34">
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Style.Triggers>
                  <!-- None left. Coloured rather than hidden: it is the row worth acting on. -->
                  <DataTrigger Binding="{Binding IsOut}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Warn}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="140" />
              <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160" />
              <DataGridTextColumn Header="Have" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="90" />
              <DataGridTextColumn Header="Reorder at" Binding="{Binding ReorderLevel, StringFormat={}{0:0.###}}" Width="110" />
              <DataGridTextColumn Header="Short by" Binding="{Binding ShortBy, StringFormat={}{0:0.###}}" Width="110" />
            </DataGrid.Columns>
          </DataGrid>

          <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="CORRECT A COUNT — AFTER A DELIVERY, A BREAKAGE OR A RECOUNT"
                         Style="{StaticResource Heading}" />
              <TextBlock Text="{Binding AdjustTarget, Mode=OneWay}" Margin="0,0,0,10" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="New count" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}" Width="110"
                         Padding="8,6" Margin="0,0,18,0" />
                <TextBlock Text="Why" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding AdjustReason, UpdateSourceTrigger=PropertyChanged}" Width="320"
                         Padding="8,6" Margin="0,0,18,0" />
                <Button Content="Apply" Padding="18,6" Click="Adjust_Click"
                        IsEnabled="{Binding CanAdjust, Mode=OneWay}" />
              </StackPanel>
              <TextBlock Text="The change and the reason are kept, so a count that stops matching the shelf can be traced back to where it went."
                         Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- ==== Settings ==== -->
      <TabItem Header="Settings  (Ctrl+3)">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,12,8,8">
          <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <!--
              Absent on the no-tax build. That build cannot issue a tax invoice, so offering the
              choice would be offering something it will not do — and a control that quietly does
              nothing is worse than no control.
            -->
            <Border x:Name="TaxModeCard" Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <TextBlock Text="WHAT KIND OF BILL THIS LANE ISSUES" Style="{StaticResource Heading}" />

                <RadioButton x:Name="ModeGst" GroupName="TaxMode" Foreground="{StaticResource Ink}"
                             Margin="0,4,0,12" Checked="TaxMode_Checked" Tag="Gst">
                  <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="Tax invoice — charge GST" FontSize="15" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" MaxWidth="760" Margin="0,3,0,0"
                               Text="GST is extracted from the shelf price and shown on the bill, on the screen and on the day-end report. This is the normal setting." />
                  </StackPanel>
                </RadioButton>

                <RadioButton x:Name="ModeComposition" GroupName="TaxMode" Foreground="{StaticResource Ink}"
                             Margin="0,0,0,4" Checked="TaxMode_Checked" Tag="Composition">
                  <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="Bill of supply — composition scheme" FontSize="15" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" MaxWidth="760" Margin="0,3,0,0"
                               Text="For a dealer registered under the composition scheme, who has a GSTIN but may not collect tax. The bill is headed BILL OF SUPPLY, carries the declaration the rules require, and shows no tax anywhere. The tax columns come off the billing screen." />
                  </StackPanel>
                </RadioButton>

                <Border Background="#33FF7A66" CornerRadius="6" Padding="14,10" Margin="0,12,0,0">
                  <StackPanel>
                    <TextBlock Text="Only if the shop is genuinely on the composition scheme."
                               Foreground="{StaticResource Warn}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="A bill of supply from a shop that collected GST is the wrong document, and so is a tax invoice showing no tax. Bills already issued do not change — each one records the mode it was issued under, so your history stays as it was. The bill on screen must be finished or cleared before this can change." />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border x:Name="NoTaxCard" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="WHAT KIND OF BILL THIS LANE ISSUES" Style="{StaticResource Heading}" />
                <TextBlock Text="Bill of supply — this build never charges GST" FontSize="15" />
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" MaxWidth="780" Margin="0,6,0,0"
                           Text="Every bill this lane issues is headed BILL OF SUPPLY and carries the declaration the composition scheme requires. There is nothing to switch here: this is the no-tax build, and it cannot issue a tax invoice." />
                <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" MaxWidth="780" Margin="0,10,0,0"
                           Text="If the shop registers normally and starts collecting GST, install the GST build instead. Its installer is named RetailPOS-GST-Setup. Your database, settings and backups are kept — bills already issued keep the document they were issued as." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="WHO MAY OPEN THIS SCREEN" Style="{StaticResource Heading}" />
                <TextBlock x:Name="PinState" Margin="0,0,0,12" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="PIN" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <PasswordBox x:Name="PinBox" Width="200" Padding="8,6" Margin="0,0,10,0" />
                  <TextBlock Text="again" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <PasswordBox x:Name="PinBoxAgain" Width="200" Padding="8,6" Margin="0,0,18,0" />
                  <Button Content="Save PIN" Padding="16,6" Margin="0,0,10,0" Click="SavePin_Click" />
                  <Button Content="Remove PIN" Padding="16,6" Click="ClearPin_Click" />
                </StackPanel>
                <TextBlock Style="{StaticResource Label}" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="820"
                           Text="At least 4 characters, and not something everybody tries first. It is stored scrambled, so there is no way to recover a forgotten one. This keeps a cashier out of the figures; it does not encrypt the database — anyone who can log in to Windows as this user can still read it with other software." />
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Footer ================================================================================ -->
    <Border Grid.Row="2" Background="{StaticResource SurfaceRaised}" Padding="24,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" x:Name="StatusLine" Text="{Binding Status, Mode=OneWay}"
                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Style="{StaticResource Label}" VerticalAlignment="Center"
                   Text="Esc closes this and goes back to billing" />
      </Grid>
    </Border>
  </Grid>
</Window>
