<Window x:Class="Pos.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetailPOS" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" FontFamily="Segoe UI">

  <!--
    A question before something that changes the books, in the till's own colours, with buttons that
    say what they do. The system's message box was white on a dark screen and answered every question
    with "OK" - which is not an answer to "cancel this supplier's bill?".

    Enter is the button on the right and Esc the one on the left, as they were: the acceptance run,
    and an owner's fingers, already know that.
  -->
  <Grid Margin="26,22,26,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Border x:Name="Badge" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource InfoSoft}"
              VerticalAlignment="Center" Margin="0,0,14,0">
        <TextBlock x:Name="Symbol" Style="{StaticResource Glyph}" FontSize="18" HorizontalAlignment="Center" />
      </Border>
      <TextBlock x:Name="Heading" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"
                 TextWrapping="Wrap" MaxWidth="400" />
    </StackPanel>

    <TextBlock x:Name="Message" Grid.Row="1" Margin="0,16,0,0" FontSize="14" LineHeight="21"
               TextWrapping="Wrap" Foreground="{DynamicResource InkMuted}" />

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="No" Padding="18,8" Margin="0,0,10,0" IsCancel="True" Click="No_Click" />
      <Button x:Name="Yes" Padding="20,8" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Yes_Click" />
    </StackPanel>
  </Grid>
</Window>
