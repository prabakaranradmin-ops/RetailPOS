<Window x:Class="Pos.App.Views.CustomerDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Pos.App.Views"
        Title="RetailPOS — Customer display"
        WindowStyle="None" ResizeMode="NoResize" ShowActivated="False" ShowInTaskbar="False"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI, Nirmala UI">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <!-- The customer's side of the counter. Large, and nothing on it can be pressed. -->
  <Grid Margin="48,36">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding ShopName}" FontSize="34" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Text="{Binding Customer}" FontSize="22" Foreground="{DynamicResource InkMuted}"
                 VerticalAlignment="Center" Margin="24,0,0,0" />
    </Grid>

    <!-- Nothing on the bill: a welcome. -->
    <TextBlock Grid.Row="1" Text="{Binding Words.Welcome}" FontSize="96" FontWeight="Light"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}" />

    <!-- Paid: the change, and thanks. -->
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding IsThanks, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{Binding Words.ThankYou}" FontSize="48" HorizontalAlignment="Center" />
      <StackPanel HorizontalAlignment="Center" Margin="0,30,0,0"
                  Visibility="{Binding HasChange, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{Binding Words.YourChange}" FontSize="22" Foreground="{DynamicResource InkMuted}" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Change}" FontSize="96" FontWeight="Bold" Foreground="{DynamicResource Positive}"
                   FontFamily="{StaticResource FigureFont}" HorizontalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <!-- The bill as it goes on, latest at the foot. -->
    <Grid Grid.Row="1" Margin="0,24,0,0">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsBill}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPaying}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsKhata}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <!-- Paying by UPI: the code with the exact amount, in place of the lines, as large as the
           screen allows. The total, paid and balance stay below it. -->
      <Border x:Name="UpiPanel" Background="White" CornerRadius="10" Padding="24,16" HorizontalAlignment="Center"
              Visibility="{Binding ShowsUpiQr, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{Binding Words.ScanToPay}" FontSize="24" FontWeight="SemiBold" Foreground="Black"
                     HorizontalAlignment="Center" />
          <v:QrCodeView x:Name="UpiCode" Grid.Row="1" Text="{Binding UpiQr, Mode=OneWay}"
                        MinWidth="160" MinHeight="160" MaxWidth="520" MaxHeight="520" Margin="0,8" />
          <TextBlock Grid.Row="2" Text="{Binding UpiAmount, Mode=OneWay}" FontSize="48" FontWeight="Bold" Foreground="Black"
                     FontFamily="{StaticResource FigureFont}" HorizontalAlignment="Center" />
          <TextBlock Grid.Row="3" Text="{Binding UpiPayee, Mode=OneWay}" FontSize="18" Foreground="#FF333333"
                     HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center" />
        </Grid>
      </Border>

      <ItemsControl ItemsSource="{Binding Lines}" VerticalAlignment="Bottom"
                    Visibility="{Binding ShowsLines, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" FontSize="26" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="26" HorizontalAlignment="Right"
                         Foreground="{DynamicResource InkMuted}" />
              <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="26" HorizontalAlignment="Right"
                         FontFamily="{StaticResource FigureFont}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <!-- The figure the customer looks for. -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceRaised}" CornerRadius="10" Padding="28,18" Margin="0,24,0,0">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsBill}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPaying}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Saving}" FontSize="24" Foreground="{DynamicResource Positive}" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                      Visibility="{Binding IsPaying, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontSize="24" Foreground="{DynamicResource InkMuted}">
              <Run Text="{Binding Words.Paid, Mode=OneWay}" /> <Run Text="{Binding Paid, Mode=OneWay}" />
              <Run Text="   " /><Run Text="{Binding Words.Balance, Mode=OneWay}" /> <Run Text="{Binding Balance, Mode=OneWay}" />
            </TextBlock>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Text="{Binding Words.Total}" FontSize="22" Foreground="{DynamicResource InkMuted}" HorizontalAlignment="Right" />
          <TextBlock Text="{Binding Total}" FontSize="80" FontWeight="Bold" FontFamily="{StaticResource FigureFont}"
                     Foreground="{DynamicResource Positive}" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
